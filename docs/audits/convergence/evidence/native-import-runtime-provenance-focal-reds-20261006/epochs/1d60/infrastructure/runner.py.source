]
if len(EXPECTED) != 43 or len(set(EXPECTED)) != 43:
    raise AssertionError("FOCAL_EXPECTED_IDS_NOT_UNIQUE")


class FocalExecution:
    """Bounded actual pytest collection/call observations, not call profiling."""
    def __init__(self):
        self.collected,self.calls,self.not_passed,self.xfail,self.skipped=[],[],[],[],[]
        self.phases={"setup":[],"call":[],"teardown":[]}
        self.overflow,self.errors=0,0
    def save(self,target,value):
        if not isinstance(value,str) or len(value)>4096 or len(target)>=64:
            self.overflow+=1
        else:
            target.append(value)
    def pytest_collection_finish(self,session):
        for item in session.items: self.save(self.collected,item.nodeid)
    def pytest_runtest_logreport(self,report):
        if report.when in self.phases: self.save(self.phases[report.when],report.nodeid)
        else: self.errors+=1
        if report.when=="call": self.save(self.calls,report.nodeid)
        if report.outcome!="passed": self.save(self.not_passed,report.when+"::"+report.nodeid)
        if hasattr(report,"wasxfail"): self.save(self.xfail,report.when+"::"+report.nodeid)
        if report.skipped: self.save(self.skipped,report.when+"::"+report.nodeid)
    def summary(self,cases):
        expected_pairs={
            (node.split("::",1)[0].removesuffix(".py").replace("/","."),node.split("::",1)[1])
            for node in EXPECTED}
        actual_pairs=[(case.attrib.get("classname"),case.attrib.get("name")) for case in cases]
        exact=(not (self.overflow or self.errors or self.xfail or self.skipped or self.not_passed)
            and Counter(self.collected)==Counter(EXPECTED)
            and Counter(self.calls)==Counter(EXPECTED)
            and all(Counter(rows)==Counter(EXPECTED) for rows in self.phases.values())
            and Counter(actual_pairs)==Counter(expected_pairs))
        return {"schema":"rc6.bounded-pytest-collection-execution.v1","expected_unique_nodeids":EXPECTED,
            "actual_collected_nodeids":self.collected,"actual_executed_call_nodeids":self.calls,
            "actual_reported_phase_nodeids":self.phases,
            "junit_classname_name_pairs":actual_pairs,"junit_expected_pairs":sorted(expected_pairs),
            "exact_collection_call_junit_bijection":exact,"record_bound":64,"overflow_count":self.overflow,
            "observer_errors":self.errors,"nonpassed_reports":self.not_passed,"xfail_reports":self.xfail,
            "skipped_reports":self.skipped,"scope":"ONE_ACTUAL_PYTEST_COLLECTION_CALL_PHASE_AND_JUNIT_JOIN"}
if (os.getenv("PYTEST_DISABLE_PLUGIN_AUTOLOAD") != "1"
        or os.getenv("PYTHONDONTWRITEBYTECODE") != "1"
        or sys.version_info[:2] != (3,11)
        or sys.prefix != "/workspace/venv_rc6_frozen311"):
    raise AssertionError("EXACT_LITERAL_FROZEN311_ENVIRONMENT_REQUIRED")
sys.dont_write_bytecode = True
sys.path.insert(0,str(SOURCE))
os.chdir(SOURCE)
profile = runpy.run_path(str(SOURCE/PROFILE))
index_path = EXECUTION/"source.index.json"
index_wire = profile["raw"](index_path)
index_sha = hashlib.sha256(index_wire).hexdigest()
pin = json.loads(index_wire)
before,authority = profile["verify_source"](REPOSITORY,SOURCE,SHA,TREE,pin)
environment = profile["environment_qualification"](SOURCE)
from scripts.rc6_native_import_provenance import prepare_binding
binding = prepare_binding(source_root=str(SOURCE),source_repo=str(REPOSITORY),source_sha=SHA,
    source_tree=TREE,source_index=str(index_path))
if (binding["source_sha"] != SHA or binding["source_tree"] != TREE
        or binding["source_index_sha256"] != index_sha
        or binding["source_file_count"] != len(before["files"])
        or binding["parent_environment_before_fixtures"]["installed_total"] != 157):
    raise AssertionError("ACTUAL_IMPORT_BINDING_PREFLIGHT_NOT_QUALIFIED")
import pytest
imports_before = profile["import_inventory"](SOURCE,before)
fixtures = EXECUTION/"fixtures"
if fixtures.exists():
    raise AssertionError("FIXTURE_CREATED_BEFORE_SOURCE_AND_ACTUAL157_QUALIFICATION")
fixtures.mkdir(mode=0o700)
guard = profile["PrivateExecutionGuard"](fixtures,fixtures/"unused-sealed-primary.sqlite")
nodes = [
    "tests/test_rc6_native_big_import_provenance.py",
    "tests/test_issue465_stress.py::test_canonical_factory_stress_uses_private_native_roots_and_matching_fingerprint",
]
# The unchanged canonical test creates a real-disk directory under cwd. Keep
# cwd private outside Source, while absolute source nodes/import roots remain
# the exact frozen Git source.
os.chdir(fixtures)
junit = EXECUTION/"native-import-provenance-focal.junit.xml"
command = [str(SOURCE/node.split("::",1)[0])+("::"+node.split("::",1)[1] if "::" in node else "")
    for node in nodes]
command += ["-q","-p","no:cacheprovider","--junitxml="+str(junit),"--basetemp="+str(fixtures/"pytest")]
command += ["--rootdir="+str(SOURCE)]
execution_observer=FocalExecution()
started = time.monotonic()
error = None
try:
    exit_code = int(pytest.main(command,plugins=[execution_observer]))
except BaseException as exception:
    exit_code = 99
    error = {"class":type(exception).__name__,"reason":str(exception)}
finally:
    wall = time.monotonic()-started
    guard_summary = guard.summary()
    guard.close()
    os.chdir(SOURCE)
after,authority_after = profile["verify_source"](REPOSITORY,SOURCE,SHA,TREE,pin)
imports_after = profile["import_inventory"](SOURCE,before)
junit_wire = profile["raw"](junit) if junit.exists() else b""
cases = ET.fromstring(junit_wire).findall(".//testcase") if junit_wire else []
failures = sum(case.find("failure") is not None for case in cases)
errors = sum(case.find("error") is not None for case in cases)
skipped = sum(case.find("skipped") is not None for case in cases)
execution_join = execution_observer.summary(cases)
index_unchanged = hashlib.sha256(profile["raw"](index_path)).hexdigest() == index_sha
tar_unchanged = profile["signature"](EXECUTION/"source.tar")["sha256"] == pin["tar_sha256"]
green = (exit_code == 0 and error is None and len(cases) == 43 and not (failures or errors or skipped)
    and execution_join["exact_collection_call_junit_bijection"]
    and before == after and index_unchanged and tar_unchanged
    and guard_summary["network_attempt_count"] == guard_summary["sqlite_rejected_count"] == 0)
receipt = {
    "schema":"rc6.native-big-import-provenance-focal-receipt.v1",
    "classification":"SCOPED_IMPORT_GUARDS_AND_ORIGINAL_CANONICAL_FACTORY_GREEN" if green else "SCOPED_IMPORT_GUARDS_NOT_GREEN",
    "phase":"INTERMEDIATE_EXACT_COMPLETE_OWN_GIT_SOURCE_NOT_FINAL_CANDIDATE",
    "native_pid":os.getpid(),"native_parent_pid":os.getppid(),
    "source_sha":SHA,"source_tree":TREE,"source_file_count":len(before["files"]),"overlay_count":0,
    "source_authority_before":authority,"source_authority_after":authority_after,
    "source_index_sha256":index_sha,"source_index_unchanged":index_unchanged,
    "source_tar_sha256":pin["tar_sha256"],"source_tar_unchanged":tar_unchanged,
    "whole_source_bytes_modes_and_blobs_unchanged":before == after,
    "environment_qualification_before_fixtures":environment,
    "actual_prepare_binding_before_fixtures":{
        key:binding[key] for key in ("schema","source_sha","source_tree","source_index_sha256",
            "source_file_count","prepared_by_pid","parent_environment_before_fixtures",
            "sys_path_before_fixtures","scope")},
    "fixture_created_after_source_and_literal157_qualification":True,"fixture_namespace":str(fixtures),
    "command":command,"pytest_exit_code":exit_code,"exception":error,"wall_seconds":wall,
    "actual_collection_execution_junit_join":execution_join,
    "private_execution_guard":guard_summary,"imports_before_fixtures":imports_before,"imports_after":imports_after,
    "import_graph_scope":"RETAINED_MODULE_LOCATIONS_AT_BOUNDARIES_NOT_TRANSIENT_HARNESS_CLOSURE",
    "runner":{"path":str(RUNNER),"sha256":hashlib.sha256(profile["raw"](RUNNER)).hexdigest(),
        "scope":"CONTROLLED_EXTERNAL_MAIN_EXECUTED_VIA_C_NOT_AN_IMPORTED_PROJECT_MODULE"},
    "junit":{"path":str(junit),"sha256":hashlib.sha256(junit_wire).hexdigest(),"bytes":len(junit_wire),
        "tests":len(cases),"failures":failures,"errors":errors,"skipped":skipped,"expected_tests":43,
        "cases":[{"classname":case.attrib.get("classname"),"name":case.attrib.get("name"),
            "seconds":case.attrib.get("time"),"status":"FAIL" if case.find("failure") is not None else
            "ERROR" if case.find("error") is not None else "SKIP" if case.find("skipped") is not None else "PASS"}
            for case in cases]},
    "native_big_executions":0,"native_horizon_executions":0,"real_orders_sent":0,"real_routes":"NOT_CALLED",
    "artifact_validated":False,"runtime_validated":False,"deployed":False,"final_input_provenance":None,
    "limits":["One exact scoped execution; no addition to prior suite counts or original55/R counts.",
        "Observer controls include explicit telemetry/control bindings and one fork failure injection; not full raw-Git canonical-spawn business acceptance.",
        "The unchanged canonical factory case exercises its native20 catalog/5 PAPER EXIT/slow-fsync; no BIG12k/60k, horizon1201, provider timing, economic edge, image or final-Gov claim.",
        "Parent socket/SQLite guard is a Python harness barrier, not OS isolation of all descendants. Unit-child adversaries are intentional private fixtures.",
        "Boundary snapshots verify retained locations; they do not claim transient imports for the entire focal harness."],
}
destination = EXECUTION/"native-import-provenance-focal-receipt.json"
destination.write_text(json.dumps(receipt,indent=2,sort_keys=True)+"\n")
print(json.dumps({"classification":receipt["classification"],"source_sha":SHA,"tests":len(cases),
    "failures":failures,"errors":errors,"skipped":skipped,"source_unchanged":before == after,
    "wall_seconds":wall,"receipt":str(destination),
    "receipt_sha256":hashlib.sha256(profile["raw"](destination)).hexdigest()}),flush=True)
raise SystemExit(0 if green else 1)
