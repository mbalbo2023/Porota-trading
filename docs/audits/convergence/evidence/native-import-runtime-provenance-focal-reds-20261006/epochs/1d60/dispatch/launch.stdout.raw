s),\"failures\":failures,\"errors\":errors,\"skipped\":skipped,\"expected_tests\":43,\\n        \"cases\":[{\"classname\":case.attrib.get(\"classname\"),\"name\":case.attrib.get(\"name\"),\\n            \"seconds\":case.attrib.get(\"time\"),\"status\":\"FAIL\" if case.find(\"failure\") is not None else\\n            \"ERROR\" if case.find(\"error\") is not None else \"SKIP\" if case.find(\"skipped\") is not None else \"PASS\"}\\n            for case in cases]},\\n    \"native_big_executions\":0,\"native_horizon_executions\":0,\"real_orders_sent\":0,\"real_routes\":\"NOT_CALLED\",\\n    \"artifact_validated\":False,\"runtime_validated\":False,\"deployed\":False,\"final_input_provenance\":None,\\n    \"limits\":[\"One exact scoped execution; no addition to prior suite counts or original55/R counts.\",\\n        \"Observer controls include explicit telemetry/control bindings and one fork failure injection; not full raw-Git canonical-spawn business acceptance.\",\\n        \"The unchanged canonical factory case exercises its native20 catalog/5 PAPER EXIT/slow-fsync; no BIG12k/60k, horizon1201, provider timing, economic edge, image or final-Gov claim.\",\\n        \"Parent socket/SQLite guard is a Python harness barrier, not OS isolation of all descendants. Unit-child adversaries are intentional private fixtures.\",\\n        \"Boundary snapshots verify retained locations; they do not claim transient imports for the entire focal harness.\"],\\n}\\ndestination = EXECUTION/\"native-import-provenance-focal-receipt.json\"\\ndestination.write_text(json.dumps(receipt,indent=2,sort_keys=True)+\"\\\\n\")\\nprint(json.dumps({\"classification\":receipt[\"classification\"],\"source_sha\":SHA,\"tests\":len(cases),\\n    \"failures\":failures,\"errors\":errors,\"skipped\":skipped,\"source_unchanged\":before == after,\\n    \"wall_seconds\":wall,\"receipt\":str(destination),\\n    \"receipt_sha256\":hashlib.sha256(profile[\"raw\"](destination)).hexdigest()}),flush=True)\\nraise System