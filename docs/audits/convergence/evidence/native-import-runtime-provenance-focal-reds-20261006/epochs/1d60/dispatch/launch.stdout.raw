{"command": ["/workspace/venv_rc6_frozen311/bin/python", "-I", "-B", "-c", "exec(compile(b'\"\"\"Controlled focal harness; exact OWN source, no BIG or horizon execution.\\n\\nExecuted as a frozen, hashed external main via -c. This harness is not an\\nimported candidate module and supplies no image/runtime/final-Gov authority.\\n\"\"\"\\nimport hashlib\\nimport json\\nimport os\\nfrom collections import Counter\\nfrom pathlib import Path\\nimport runpy\\nimport sys\\nimport time\\nimport xml.etree.ElementTree as ET\\n\\nREPOSITORY = Path(\"/workspace/porota_rc6_worktrees/budget_import_runtime_provenance\")\\nEXECUTION = Path(\"/workspace/rc6-budget-runtime-provenance-1d60-focal-157-raw\")\\nSOURCE = Path(\"/workspace/rc6-budget-runtime-provenance-1d60-focal-157-source\")\\nSHA = \"1d60ec2ced05ce7793028f5a04f707cb66fa5cda\"\\nTREE = \"a21e16b7d365b202996c835eda6baebbc8b0ffb4\"\\nRUNNER = Path(\"/workspace/rc6-budget-runtime-provenance-1d60-focal-runner.py\")\\nPROFILE = \"docs/audits/rc6-convergence-persistence-evidence/native_archive_v3_profile_probe_v2.py\"\\nEXPECTED = [\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_retained_pinned_module_origin_is_reported\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_exec_of_alien_module_deleted_after_import_remains_blocked\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_opaque_exec_is_unverified_without_generic_allowlist\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_unresolved_filename_none_is_not_treated_as_a_closed_import\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_bounded_audit_overflow_keeps_complete_counter_and_refuses_closure\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_audit_hook_deactivation_does_not_contaminate_next_observer\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_snapshot_failure_unconditionally_deactivates_owned_hook\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_stress_early_failure_deactivates_hook_before_next_observer[root_abort]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_stress_early_failure_deactivates_hook_before_next_observer[fixture_abort]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_child_startup_base_exception_deactivates_owned_hook[child_initial_abort]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_child_startup_base_exception_deactivates_owned_hook[child_queue_abort]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_nonzero_actual_child_preserves_initial_and_failure_proof_in_typed_evidence\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_partial_source_cli_is_rejected_before_fixture_or_business_import\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_wrong_source_pin_rejects_before_environment_or_fixture\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_wrong_actual_parent_pid_reports_incomplete_before_product_startup\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_late_proof_allocation_is_covered_by_actual_reaped_children_peak\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_unreaped_child_does_not_claim_a_lifetime_rss\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_callback_source_has_no_hash_io_profile_or_gc_operation\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_exact_typing_public_aliases_are_classified_without_pretending_module_type\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_audit_hook_installation_requires_unique_owned_sentinel_and_restores_after_failure[audit_hook_veto-0-ValueError]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_audit_hook_installation_requires_unique_owned_sentinel_and_restores_after_failure[audit_hook_duplicate-2-ValueError]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_audit_hook_installation_requires_unique_owned_sentinel_and_restores_after_failure[audit_hook_error-0-KeyboardInterrupt]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_false_typing_alias_with_real_metaclass_and_matching_name_stays_unverified[false_typing_alias]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_false_typing_alias_with_real_metaclass_and_matching_name_stays_unverified[false_typing_metadata]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_loader_metaclass_descriptors_are_not_invoked_by_observer_and_original_delegation_survives[foreign_loader_result]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_loader_metaclass_descriptors_are_not_invoked_by_observer_and_original_delegation_survives[foreign_loader_abort]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_real_language_factory_exec_has_exact_code_and_callsite_evidence[namedtuple-collections.namedtuple]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_real_language_factory_exec_has_exact_code_and_callsite_evidence[dataclass-dataclasses._create_fn]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_cloned_factory_with_same_code_but_foreign_globals_is_rejected\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_valid_language_generation_over_text_bound_does_not_raise_provenance_cap\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_frozen_filename_requires_actual_interpreter_code_reference[real_frozen-True]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_frozen_filename_requires_actual_interpreter_code_reference[fake_frozen-False]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_optional_missing_outcome_is_bounded_and_distinct_from_final_absence[optional_missing-1]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_optional_missing_outcome_is_bounded_and_distinct_from_final_absence[missing_repeated-100]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_fabricated_missing_audit_event_has_no_actual_import_outcome\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_user_finder_constructed_module_not_found_is_not_core_optional_absence\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_pinned_transient_module_is_joined_to_loader_and_execution_after_deletion\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_private_alien_loader_and_base_exception_preserve_evidence_and_restore_protocol[transient_alien]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_private_alien_loader_and_base_exception_preserve_evidence_and_restore_protocol[loader_abort]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_actual_cython_extension_creation_has_exact_registry_parent_and_type_lineage\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_replaced_or_unknown_native_runtime_module_has_no_name_based_exemption[false_cython_after-cython_runtime]\",\\n    \"tests/test_rc6_native_big_import_provenance.py::test_replaced_or_unknown_native_runtime_module_has_no_name_based_exemption[unknown_runtime_module-rc6_unknown_extension_runtime]\",\\n    \"tests/test_issue465_stress.py::test_canonical_factory_stress_uses_private_native_roots_and_matching_fingerprint\"\\n]\\nif len(EXPECTED) != 43 or len(set(EXPECTED)) != 43:\\n    raise AssertionError(\"FOCAL_EXPECTED_IDS_NOT_UNIQUE\")\\n\\n\\nclass FocalExecution:\\n    \"\"\"Bounded actual pytest collection/call observations, not call profiling.\"\"\"\\n    def __init__(self):\\n        self.collected,self.calls,self.not_passed,self.xfail,self.skipped=[],[],[],[],[]\\n        self.phases={\"setup\":[],\"call\":[],\"teardown\":[]}\\n        self.overflow,self.errors=0,0\\n    def save(self,target,value):\\n        if not isinstance(value,str) or len(value)>4096 or len(target)>=64:\\n            self.overflow+=1\\n        else:\\n            target.append(value)\\n    def pytest_collection_finish(self,session):\\n        for item in session.items: self.save(self.collected,item.nodeid)\\n    def pytest_runtest_logreport(self,report):\\n        if report.when in self.phases: self.save(self.phases[report.when],report.nodeid)\\n        else: self.errors+=1\\n        if report.when==\"call\": self.save(self.calls,report.nodeid)\\n        if report.outcome!=\"passed\": self.save(self.not_passed,report.when+\"::\"+report.nodeid)\\n        if hasattr(report,\"wasxfail\"): self.save(self.xfail,report.when+\"::\"+report.nodeid)\\n        if report.skipped: self.save(self.skipped,report.when+\"::\"+report.nodeid)\\n    def summary(self,cases):\\n        expected_pairs={\\n            (node.split(\"::\",1)[0].removesuffix(\".py\").replace(\"/\",\".\"),node.split(\"::\",1)[1])\\n            for node in EXPECTED}\\n        actual_pairs=[(case.attrib.get(\"classname\"),case.attrib.get(\"name\")) for case in cases]\\n        exact=(not (self.overflow or self.errors or self.xfail or self.skipped or self.not_passed)\\n            and Counter(self.collected)==Counter(EXPECTED)\\n            and Counter(self.calls)==Counter(EXPECTED)\\n            and all(Counter(rows)==Counter(EXPECTED) for rows in self.phases.values())\\n            and Counter(actual_pairs)==Counter(expected_pairs))\\n        return {\"schema\":\"rc6.bounded-pytest-collection-execution.v1\",\"expected_unique_nodeids\":EXPECTED,\\n            \"actual_collected_nodeids\":self.collected,\"actual_executed_call_nodeids\":self.calls,\\n            \"actual_reported_phase_nodeids\":self.phases,\\n            \"junit_classname_name_pairs\":actual_pairs,\"junit_expected_pairs\":sorted(expected_pairs),\\n            \"exact_collection_call_junit_bijection\":exact,\"record_bound\":64,\"overflow_count\":self.overflow,\\n            \"observer_errors\":self.errors,\"nonpassed_reports\":self.not_passed,\"xfail_reports\":self.xfail,\\n            \"skipped_reports\":self.skipped,\"scope\":\"ONE_ACTUAL_PYTEST_COLLECTION_CALL_PHASE_AND_JUNIT_JOIN\"}\\nif (os.getenv(\"PYTEST_DISABLE_PLUGIN_AUTOLOAD\") != \"1\"\\n        or os.getenv(\"PYTHONDONTWRITEBYTECODE\") != \"1\"\\n        or sys.version_info[:2] != (3,11)\\n        or sys.prefix != \"/workspace/venv_rc6_frozen311\"):\\n    raise AssertionError(\"EXACT_LITERAL_FROZEN311_ENVIRONMENT_REQUIRED\")\\nsys.dont_write_bytecode = True\\nsys.path.insert(0,str(SOURCE))\\nos.chdir(SOURCE)\\nprofile = runpy.run_path(str(SOURCE/PROFILE))\\nindex_path = EXECUTION/\"source.index.json\"\\nindex_wire = profile[\"raw\"](index_path)\\nindex_sha = hashlib.sha256(index_wire).hexdigest()\\npin = json.loads(index_wire)\\nbefore,authority = profile[\"verify_source\"](REPOSITORY,SOURCE,SHA,TREE,pin)\\nenvironment = profile[\"environment_qualification\"](SOURCE)\\nfrom scripts.rc6_native_import_provenance import prepare_binding\\nbinding = prepare_binding(source_root=str(SOURCE),source_repo=str(REPOSITORY),source_sha=SHA,\\n    source_tree=TREE,source_index=str(index_path))\\nif (binding[\"source_sha\"] != SHA or binding[\"source_tree\"] != TREE\\n        or binding[\"source_index_sha256\"] != index_sha\\n        or binding[\"source_file_count\"] != len(before[\"files\"])\\n        or binding[\"parent_environment_before_fixtures\"][\"installed_total\"] != 157):\\n    raise AssertionError(\"ACTUAL_IMPORT_BINDING_PREFLIGHT_NOT_QUALIFIED\")\\nimport pytest\\nimports_before = profile[\"import_inventory\"](SOURCE,before)\\nfixtures = EXECUTION/\"fixtures\"\\nif fixtures.exists():\\n    raise AssertionError(\"FIXTURE_CREATED_BEFORE_SOURCE_AND_ACTUAL157_QUALIFICATION\")\\nfixtures.mkdir(mode=0o700)\\nguard = profile[\"PrivateExecutionGuard\"](fixtures,fixtures/\"unused-sealed-primary.sqlite\")\\nnodes = [\\n    \"tests/test_rc6_native_big_import_provenance.py\",\\n    \"tests/test_issue465_stress.py::test_canonical_factory_stress_uses_private_native_roots_and_matching_fingerprint\",\\n]\\n# The unchanged canonical test creates a real-disk directory under cwd. Keep\\n# cwd private outside Source, while absolute source nodes/import roots remain\\n# the exact frozen Git source.\\nos.chdir(fixtures)\\njunit = EXECUTION/\"native-import-provenance-focal.junit.xml\"\\ncommand = [str(SOURCE/node.split(\"::\",1)[0])+(\"::\"+node.split(\"::\",1)[1] if \"::\" in node else \"\")\\n    for node in nodes]\\ncommand += [\"-q\",\"-p\",\"no:cacheprovider\",\"--junitxml=\"+str(junit),\"--basetemp=\"+str(fixtures/\"pytest\")]\\ncommand += [\"--rootdir=\"+str(SOURCE)]\\nexecution_observer=FocalExecution()\\nstarted = time.monotonic()\\nerror = None\\ntry:\\n    exit_code = int(pytest.main(command,plugins=[execution_observer]))\\nexcept BaseException as exception:\\n    exit_code = 99\\n    error = {\"class\":type(exception).__name__,\"reason\":str(exception)}\\nfinally:\\n    wall = time.monotonic()-started\\n    guard_summary = guard.summary()\\n    guard.close()\\n    os.chdir(SOURCE)\\nafter,authority_after = profile[\"verify_source\"](REPOSITORY,SOURCE,SHA,TREE,pin)\\nimports_after = profile[\"import_inventory\"](SOURCE,before)\\njunit_wire = profile[\"raw\"](junit) if junit.exists() else b\"\"\\ncases = ET.fromstring(junit_wire).findall(\".//testcase\") if junit_wire else []\\nfailures = sum(case.find(\"failure\") is not None for case in cases)\\nerrors = sum(case.find(\"error\") is not None for case in cases)\\nskipped = sum(case.find(\"skipped\") is not None for case in cases)\\nexecution_join = execution_observer.summary(cases)\\nindex_unchanged = hashlib.sha256(profile[\"raw\"](index_path)).hexdigest() == index_sha\\ntar_unchanged = profile[\"signature\"](EXECUTION/\"source.tar\")[\"sha256\"] == pin[\"tar_sha256\"]\\ngreen = (exit_code == 0 and error is None and len(cases) == 43 and not (failures or errors or skipped)\\n    and execution_join[\"exact_collection_call_junit_bijection\"]\\n    and before == after and index_unchanged and tar_unchanged\\n    and guard_summary[\"network_attempt_count\"] == guard_summary[\"sqlite_rejected_count\"] == 0)\\nreceipt = {\\n    \"schema\":\"rc6.nat