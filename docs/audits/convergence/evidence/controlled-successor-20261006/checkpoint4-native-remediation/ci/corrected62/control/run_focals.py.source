import hashlib,json,os,runpy,stat,sys,time,xml.etree.ElementTree as ET
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
SOURCE=Path('/workspace/scratch/rc6-readonly-3091e93-ofT80Pum/source')
EPOCH=sys.argv[1]
PY=SOURCE.parent/('venv'+EPOCH)/'bin/python'
OUT=ROOT/('epoch'+EPOCH)
OUT.mkdir(mode=0o700)
for name in ('hypothesis','logs','tmp'):(OUT/name).mkdir(mode=0o700)
os.umask(0o022)
original=SOURCE/'docs/audits/rc6-convergence-persistence-evidence/run_full_horizon_1201_v2.py.source'
driver=runpy.run_path(str(original))
before=driver['pre_capture_kernel_state']()
paths=('scripts/porota_predeploy_cleanup.py','scripts/porota_predeploy_test_workspace.py','.github/workflows/porota-predeploy-v2.yml','tests/test_ci_productive_predeploy_contract.py','tests/test_rc6_predeploy_scoped_cleanup.py')
def digest(path):
 fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NOATIME|os.O_CLOEXEC)
 try:
  h=hashlib.sha256()
  while b:=os.read(fd,1024*1024):h.update(b)
  return h.hexdigest()
 finally:os.close(fd)
source_before={name:digest(SOURCE/name) for name in paths}
assert source_before['scripts/porota_predeploy_cleanup.py']=='31f54855e581c48ffa2ba150819157ae0672390961b452e13eceafe33a85e85f'
env={k:v for k,v in os.environ.items() if not k.startswith(('POROTA_','PAPER_','PPI_','IOL_','BYMA_','PYTHON'))}
env.update(PYTHONDONTWRITEBYTECODE='1',PYTEST_DISABLE_PLUGIN_AUTOLOAD='1',HYPOTHESIS_STORAGE_DIRECTORY=str(OUT/'hypothesis'),LOG_DIR=str(OUT/'logs'),RUNNER_TEMP=str(OUT),TMPDIR=str(OUT/'tmp'))
argv=[str(PY),'-B','-m','pytest','-q','tests/test_ci_productive_predeploy_contract.py','tests/test_rc6_predeploy_scoped_cleanup.py','-p','no:cacheprovider','--basetemp='+str(OUT/'pytest'),'--junitxml='+str(OUT/'junit.xml')]
def save(path,value):
 raw=(json.dumps(value,indent=2,sort_keys=True)+'\n').encode()
 with path.open('wb') as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
 return hashlib.sha256(raw).hexdigest()
def progress(stage,pid,entered,deadline,fd):
 row={'stage':stage,'pid':pid,'wall_seconds':time.monotonic()-entered,'owned_log_bytes_fstat_only':os.fstat(fd).st_size,'management_deadline':deadline,'scope':'LOCAL_TWO_CI_FILES_ONLY_NOT_GOV_OR_PREDEPLOY'}
 save(OUT/'progress.json',row)
 print(json.dumps({'epoch':EPOCH,'progress':row}),flush=True)
save(OUT/'launch.json',{'argv':argv,'cwd':str(SOURCE),'source_before':source_before,'python':sys.version,'actual_kernel_before':before,'source_qualification':'UNCOMMITTED_DIAGNOSTIC_ONLY'})
print(json.dumps({'epoch':EPOCH,'start':str(OUT),'argv':argv}),flush=True)
kernel=driver['managed_native_child'](argv,SOURCE,OUT/'pytest.log',env,300,terminate_grace=2,progress_poll=5,progress=progress)
closed=driver['managed_custody_closed'](kernel)
phase=driver['managed_phase_green'](kernel)
receipt={'epoch':EPOCH,'original_raw_kernel':kernel,'actual_kernel_before':before,'physical_fin_closed':closed,'original_managed_phase_green':phase,'scope':'LOCAL_TWO_CI_FILES_ONLY_NOT_GOV_OR_PREDEPLOY','source_qualification':'UNCOMMITTED_DIAGNOSTIC_ONLY','namespace_retention':'EXPLICIT_RETAINED_DIAGNOSTIC_OUTPUTS_NOT_CLEANED','real_orders_sent':0,'docker_real_calls':0,'host_calls':0}
if closed:
 receipt['actual_kernel_after']=driver['pre_capture_kernel_state']()
 receipt['source_after']={name:digest(SOURCE/name) for name in paths}
 receipt['source_bytes_unchanged']=source_before==receipt['source_after']
 junit=OUT/'junit.xml'
 if junit.exists():
  xml=ET.parse(junit)
  cases=xml.findall('.//testcase')
  ids=[(c.get('classname','')+'::'+c.get('name','')) for c in cases]
  receipt['junit']={'path':str(junit),'sha256':digest(junit),'cases':len(cases),'failures':sum(c.find('failure') is not None for c in cases),'errors':sum(c.find('error') is not None for c in cases),'skipped':sum(c.find('skipped') is not None for c in cases),'duplicate_case_ids':len(ids)-len(set(ids))}
 # A readonly NOFOLLOW/NOATIME entry inventory; no payloads, targets or cleanup.
 queue=[OUT];seen=set();rows=0;allocated=0;logical=0;aliases=0;hardlinked=0;special=0
 while queue:
  parent=queue.pop();fd=os.open(parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_NOATIME|os.O_CLOEXEC)
  try:names=os.listdir(fd)
  finally:os.close(fd)
  for name in names:
   p=parent/name;st=p.lstat();rows+=1;identity=(st.st_dev,st.st_ino)
   if identity not in seen:seen.add(identity);allocated+=st.st_blocks*512;logical+=st.st_size
   if stat.S_ISDIR(st.st_mode):queue.append(p)
   elif stat.S_ISLNK(st.st_mode):aliases+=1
   elif stat.S_ISREG(st.st_mode):hardlinked+=st.st_nlink>1
   else:special+=1
 fd=os.open(OUT,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_NOATIME|os.O_CLOEXEC)
 try:v=os.fstatvfs(fd)
 finally:os.close(fd)
 receipt['diagnostic_namespace_retained']={'root':str(OUT),'entries':rows,'unique_inodes':len(seen),'allocated_bytes_nofollow_deduplicated':allocated,'logical_bytes_nofollow_deduplicated':logical,'aliases_retained':aliases,'hardlinked_regular_entries_retained':hardlinked,'special_entries_retained':special,'removed':False,'free_bytes':v.f_bavail*v.f_frsize,'free_inodes':v.f_favail,'free_inodes_fraction':v.f_favail/v.f_files if v.f_files else None,'floor_2GiB_ok':v.f_bavail*v.f_frsize>=2*1024**3,'floor_10pct_inodes_ok':v.f_files>0 and v.f_favail/v.f_files>=.1,'scope':'THIS_NEW_DIAGNOSTIC_NAMESPACE_ONLY_NOT_GLOBAL_CLEANUP_GREEN'}
 receipt['log']={'path':str(OUT/'pytest.log'),'sha256':digest(OUT/'pytest.log')}
sha=save(OUT/'receipt.json',receipt)
print(json.dumps({'epoch':EPOCH,'receipt':str(OUT/'receipt.json'),'sha256':sha,'physical_fin_closed':closed,'original_managed_phase_green':phase,'junit':receipt.get('junit'),'retained':receipt.get('diagnostic_namespace_retained')}),flush=True)
sys.exit(0 if phase and receipt.get('source_bytes_unchanged') else 1)
