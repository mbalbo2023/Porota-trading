"""Declared external component control; ALIEN for native Source import proof."""
import hashlib
import importlib.metadata
import json
import os
from pathlib import Path
import re
import stat
import sys

BASE = Path('/workspace/scratch/rc6-readonly-3091e93-ofT80Pum')
PROPOSAL = BASE / 'rc6-fin-compact-proposal-0f73-hco1a9ob'
ORIGINAL = PROPOSAL / 'cleanup-before.py.source'
PROPOSED = PROPOSAL / 'cleanup-after.py.source'
ORIGINAL_SHA = '31f54855e581c48ffa2ba150819157ae0672390961b452e13eceafe33a85e85f'
PROPOSED_SHA = '834395f0ed3aab232f67e713dc9d712c926aa2b4ab38e6762244f1e2d755cebf'
SAMPLES = (
    ('closed311', Path('/workspace/scratch/rc6-ci-owned-drain-focals-v2-fctzpnml/v2-epoch311/pytest/test_real_owned_pytest_failed_0/native-runner/porota-predeploy-471-2-af243396ab394adeba719cd094071a19/porota-pytest-owned-fin.json'), '528062d7a1b676eaadabb6f7668496aae4285c2714dff12e0c703b744ddb0bb3'),
    ('closed312', Path('/workspace/scratch/rc6-ci-owned-drain-focals-v2-fctzpnml/v2-epoch312/pytest/test_real_owned_pytest_failed_0/native-runner/porota-predeploy-471-2-819307d4925940049839f8e54294764c/porota-pytest-owned-fin.json'), 'e08af309a36a1ad2cbd7bfda99bd2105fbe71d1bb9475bfdbff32f52b7af7056'),
)
OVERSIZE = BASE / 'rc6-gov-ready-drain-focals-v2-tbl48vb4/epoch311/component-new-mainUnknown/governed-main/collection.parent-source-before.index.json'
OVERSIZE_SHA = '3a156c936f6d7182bdfb577660e86e6cf5c2a91a12f35482847e7b9ef31d8201'
FIELDS = ('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_uid', 'st_gid',
          'st_size', 'st_blocks', 'st_atime_ns', 'st_mtime_ns', 'st_ctime_ns')
CAP = 262144


def info(st):
    return {key: getattr(st, key) for key in FIELDS}


def captured(path, maximum):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NOATIME | os.O_CLOEXEC)
    try:
        before = info(os.fstat(fd))
        assert stat.S_ISREG(before['st_mode']) and before['st_uid'] == os.geteuid()
        assert before['st_nlink'] == 1 and before['st_size'] <= maximum
        chunks, total = [], 0
        while part := os.read(fd, min(1048576, maximum + 1 - total)):
            chunks.append(part)
            total += len(part)
            assert total <= maximum
        raw = b''.join(chunks)
        assert len(raw) == before['st_size']
        assert before == info(os.fstat(fd)) == info(path.lstat())
        return raw, before
    finally:
        os.close(fd)


def exclusive(path, raw):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())


def component(path, expected):
    raw, before = captured(path, 131072)
    assert hashlib.sha256(raw).hexdigest() == expected
    # Explicit component namespaces; no native module alias, __main__ or
    # __mp_main__ rebinding and no claimed product/source qualification.
    namespace = {'__name__': 'rc6_declared_external_publisher_component', '__file__': str(path)}
    exec(compile(raw, str(path), 'exec'), namespace)
    return namespace, before


def closure():
    rows = sorted(({'name': re.sub(r'[-_.]+', '-', d.metadata['Name']).lower(), 'version': d.version}
                   for d in importlib.metadata.distributions()), key=lambda r: (r['name'], r['version']))
    assert len(rows) == len({row['name'] for row in rows}) == 157
    return rows


class ReaderObservation:
    """Spy only this declared component's os.read; delegates every syscall."""
    def __init__(self, actual, target):
        self.actual, self.target, self.payload_reads = actual, target, 0

    def __getattr__(self, name):
        return getattr(self.actual, name)

    def read(self, fd, size):
        st = self.actual.fstat(fd)
        if (st.st_dev, st.st_ino) == self.target:
            self.payload_reads += 1
        return self.actual.read(fd, size)


def main():
    epoch, output = sys.argv[1:]
    assert epoch in ('311', '312')
    assert tuple(sys.version_info[:2]) == ((3, 11) if epoch == '311' else (3, 12))
    output = Path(output)
    assert output.is_absolute() and stat.S_IMODE(output.lstat().st_mode) == 0o700
    original, original_before = component(ORIGINAL, ORIGINAL_SHA)
    proposed, proposed_before = component(PROPOSED, PROPOSED_SHA)
    distributions = closure()
    rows = []
    for label, path, expected in SAMPLES:
        raw, source_before = captured(path, CAP)
        assert hashlib.sha256(raw).hexdigest() == expected
        value = original['decode'](raw)
        kernel = value['kernel']
        assert value['owned_fin_closed'] is True and value['phase_green'] is False
        assert kernel['returncode'] == 1 and kernel['owned_cleanup_management_bound_seconds'] == 5
        assert kernel['owned_children_exhaustion_verified'] is True
        assert kernel['process_group_absent_after_reap'] is True
        assert kernel['subreaper_restoration_readback_verified'] is True
        assert len(kernel['adopted_descendants_reaped']) == 100
        assert all(row['exit_code'] == 0 for row in kernel['adopted_descendants_reaped'])
        assert kernel['owned_group_signal_observations'] == kernel['supervisor_errors'] == []
        assert original['canonical'](value) == raw == proposed['canonical'](value)
        files = {}
        for variant, publisher, kwargs in (('original-default', original, {}),
                                           ('proposed-default', proposed, {}),
                                           ('proposed-compact', proposed, {'compact': True})):
            target = output / (label + '-' + variant + '.json')
            publisher['publish'](target, value, **kwargs)
            saved, details = original['read_file'](target, maximum=CAP, mode=0o600)
            assert original['decode'](saved) == value
            assert info(details) == info(target.lstat())
            if variant != 'proposed-compact':
                assert saved == raw
            else:
                assert saved == (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode()
            files[variant] = {'path': str(target), 'bytes': len(saved), 'sha256': hashlib.sha256(saved).hexdigest(),
                              'reader_original_limit': CAP, 'stat11': info(details), 'full_object_equal': True}
        assert source_before == info(path.lstat())
        rows.append({'label': label, 'input_path': str(path), 'input_sha256': expected, 'input_stat11': source_before,
                     'input_stat11_unchanged': True, 'original_phase_exitcode': 1,
                     'original_phase_green': False, 'original_kernel_receipt_not_reclassified': True, 'files': files})
    oversize_raw, oversize_before = captured(OVERSIZE, 3145728)
    assert hashlib.sha256(oversize_raw).hexdigest() == OVERSIZE_SHA and len(oversize_raw) == 2266447 > CAP
    denied = output / 'closed-genuine-oversize-copy.json'
    exclusive(denied, oversize_raw)
    denied_before = info(denied.lstat())
    observer = ReaderObservation(original['os'], (denied_before['st_dev'], denied_before['st_ino']))
    previous_os = original['os']
    try:
        original['os'] = observer
        try:
            original['read_file'](denied, maximum=CAP, mode=0o600)
        except original['CleanupRejected'] as error:
            assert str(error) == 'CONTROL_SIZE_LIMIT'
        else:
            raise AssertionError('ORIGINAL_READER_ACCEPTED_OVERSIZE')
    finally:
        original['os'] = previous_os
    assert observer.payload_reads == 0 and denied_before == info(denied.lstat())
    assert oversize_before == info(OVERSIZE.lstat())
    assert original_before == info(ORIGINAL.lstat()) and proposed_before == info(PROPOSED.lstat())
    assert closure() == distributions
    receipt = {'schema': 'rc6.publisher-lossless-component-control.v1', 'epoch': epoch,
               'classification': 'EXTERNAL_COMPONENT_ALIEN_FOR_SOURCE_IMPORT_PROOF_FORMATTING_ONLY_NOT_NEW_KERNEL_PROOF',
               'source_sha_context_only': '0f73e2cd681672b7a9a3065e99a72915ba93f4fd',
               'original_component_sha256': ORIGINAL_SHA, 'proposed_component_sha256': PROPOSED_SHA,
               'original_component_stat11': original_before, 'proposed_component_stat11': proposed_before,
               'installed_metadata_actual_157': distributions, 'installed_metadata_unchanged': True,
               'closed_actual100_samples': rows, 'reader_original_limit': CAP,
               'oversize_control': {'source_path': str(OVERSIZE), 'source_sha256': OVERSIZE_SHA,
                   'source_stat11': oversize_before, 'copy_path': str(denied), 'copy_stat11': denied_before,
                   'copy_bytes': len(oversize_raw), 'original_error': 'CONTROL_SIZE_LIMIT',
                   'actual_target_fd_payload_read_calls': observer.payload_reads, 'full_raw_bytes_copied': True,
                   'classification': 'ALREADY_CLOSED_CONTROL_COPY_READER_NEGATIVE_NOT_NEW_KERNEL_PROOF'},
               'publisher_control_passed': True, 'source_files_written': 0, 'real_orders_sent': 0,
               'mode': 'PRODUCTION_PAPER / SIMULATION', 'final_candidate_eligible': False,
               'full_gov_big_artifact_image_runtime_qualified': False, 'ppi_watch': 'UNTOUCHED_OUT_OF_SCOPE'}
    exclusive(output / 'component-receipt.json', (json.dumps(receipt, sort_keys=True, indent=2) + '\n').encode())
    print(json.dumps({'publisher_component_control_passed': True, 'epoch': epoch,
                      'receipt': str(output / 'component-receipt.json'), 'source_qualified': False}, sort_keys=True), flush=True)


if __name__ == '__main__':
    main()
