def require(condition, reason):
    if not condition:
        raise ValueError(reason)


def read_owned(path, limit=128*1024**2):
    """Descriptor read only; preserve and compare all eleven file fields."""
    path = Path(path).absolute()
    require(path.resolve(strict=True) == path and not any(p.is_symlink() for p in path.parents),
            'REGULAR_UNALIASED_FILE_REQUIRED')
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NOATIME | os.O_NONBLOCK)
    try:
        before = os.fstat(fd)
        require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1
                and before.st_uid == os.geteuid() and before.st_size <= limit,
                'OWNED_BOUNDED_REGULAR_FILE_REQUIRED')
        parts, total = [], 0
        while block := os.read(fd, min(1024**2, limit+1-total)):
            parts.append(block); total += len(block)
            require(total <= limit, 'FILE_BOUND_EXCEEDED')
        after, location = os.fstat(fd), path.lstat()
        require(total == before.st_size and all(getattr(before, key) == getattr(after, key)
                == getattr(location, key) for key in FIELDS), 'FILE_CHANGED_DURING_NOATIME_CAPTURE')
        return b''.join(parts), {key: getattr(before, key) for key in FIELDS}
    finally:
        os.close(fd)


def write_new(path, wire, mode=0o600):
    path = Path(path)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(wire); stream.flush(); os.fchmod(stream.fileno(), mode); os.fsync(stream.fileno())


def publish(name, value):
    gov.publish(RAW/name, gov.canonical(value))


def failure(error, stage):
    literal = str(error).partition(':')[0]
    row = {'stage': stage, 'class': type(error).__name__,
           'reason': literal if re.fullmatch(r'[A-Z][A-Z0-9_]{0,191}', literal) else 'NON_LITERAL_EXCEPTION'}
    if isinstance(error, OSError) and type(error.errno) is int:
        row['errno'] = error.errno
    return row


def data_custody(path):
    result = {}
    for suffix in ('', '-wal', '-shm', '-journal'):
        member = Path(str(path)+suffix)
        try:
            member.lstat()
        except FileNotFoundError:
            require(bool(suffix), 'SOURCE_DATABASE_MISSING')
            continue
        wire, fields = read_owned(member, limit=512*1024**2)
        result[suffix] = {**fields, 'sha256': hashlib.sha256(wire).hexdigest()}
    return result


def load_governed():
    global gov
    require(sys.executable == PYTHON and platform.python_version() == '3.11.16'
            and os.getuid() == os.geteuid() != 0, 'EXACT_NONROOT_LOCKED311_REQUIRED')
    require(str(SOURCE) not in sys.path, 'NO_PREEXISTING_DIAGNOSTIC_SOURCE_ALIAS')
    sys.path.insert(0, str(SOURCE))
    from scripts import rc6_controlled_governed_runner
    gov = rc6_controlled_governed_runner
    require(Path(gov.__file__).absolute() == SOURCE/'scripts/rc6_controlled_governed_runner.py',
            'ORIGINAL_TRACKED_GOVERNED_HELPER_REQUIRED')


def setup(phase):
    namespace = gov.phase_namespace(SOURCE, RAW, phase)
    capability = gov.restrict_inet_creation()
    observations = {'inet_socket_attempts': [], 'inet_socket_constructor_requests': [],
                    'subprocess_executable_counts': {}}
    gov.install_phase_audit(observations)
    publish(phase+'.namespace.json', namespace)
    publish(phase+'.offline-capability.json', capability)
    publish(phase+'.installed-closure.json', gov.installed_closure(SOURCE))
    return observations


def binding():
    from scripts.rc6_native_import_provenance import prepare_binding
    require(hashlib.sha256(gov.capture(PIN)[0]).hexdigest() == INDEX_SHA, 'EXACT_SOURCE_INDEX_REQUIRED')
    return prepare_binding(source_root=str(SOURCE), source_repo=str(REPOSITORY),
                           source_sha=SHA, source_tree=TREE, source_index=str(PIN))


def source_snapshot(root, bound):
    physical_before = gov.physical_namespace(root)
    records = {}
    for name, expected in bound['files'].items():
        wire, attrs = gov.capture(root/name)
        blob = hashlib.sha1(b'blob '+str(len(wire)).encode()+b'\0'+wire).hexdigest()
        mode = '100'+format(stat.S_IMODE(attrs['st_mode']), '03o')
        require(hashlib.sha256(wire).hexdigest() == expected['sha256']
                and blob == expected['blob_id'] and mode == expected['mode'], 'PHYSICAL_SOURCE_PIN_MISMATCH')
        records[name] = {'sha256': expected['sha256'], 'git_blob': blob, 'git_mode': mode,
                         'bytes': len(wire), 'stat_fields': attrs}
    physical_after = gov.physical_namespace(root)
    require(physical_before == physical_after and set(records) == set(physical_after['files']),
            'PHYSICAL_SOURCE_NAMESPACE_CHANGED_OR_NONLITERAL')
    return {'source_sha': SHA, 'source_tree': TREE, 'source_index_sha256': INDEX_SHA,
            'files': records, 'physical_directories': physical_after['directories'], 'overlay_count': 0,
            'git_metadata': {'source_repo': str(REPOSITORY),
                             'raw_git_commit_sha256': json.loads(gov.capture(PIN)[0])['raw_git_commit_sha256'],
                             'source_index_sha256': INDEX_SHA},
            'scope': 'ALL_LITERAL_BYTES_MODES_RAW_GIT_CODE10_STABLE_WITH_SEPARATE_ATIME'}

