"""One native families._read diagnosis on copied CLOSED synthetic bytes.

No SQL fixture preparation, extra SELECT, source edit, overlay, product alias,
function/cursor/list replacement, GC change, browser or full BIG run occurs.
The original 0.5 deadline and original capture/scratch guards remain active.
All profiling and timing are instrumental, DIAGNOSTIC_ONLY and never a gate.
"""
from __future__ import annotations

