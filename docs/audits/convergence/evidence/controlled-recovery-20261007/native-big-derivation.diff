+def native_fin_control(gov, raw, kernel, args, source, repository, index_path):
+    """Only native controls are read before the immutable original five-second FIN."""
+    path = raw/"native-big-result.json.owned-fin.json"
+    wire, attributes = gov.capture(path, limit=256*1024)
+    row = json.loads(wire)
+    lifecycle = row["native_cli_lifecycle"]
+    finalization = lifecycle["child_infrastructure_finalization"]
+    expected_binding = {"source_root": str(source), "source_repo": str(repository),
+        "source_sha": args.sha, "source_tree": args.tree, "source_index": str(index_path),
+        "source_index_sha256": args.index_sha256}
+    gov.require(row["schema"] == "rc6.issue465.native-cli-owned-fin.v1"
+        and row["payload_path"] == str(raw/"native-big-result.json")
+        and row["source_binding"] == expected_binding
+        and row["pid"] == lifecycle["pid"] == kernel["pid"]
+        and row["parent_pid"] == lifecycle["parent_pid"] == os.getpid()
+        and row["entry_module"] == lifecycle["entry_module"] == "__main__"
+        and row["physical_fin_closed"] is True
+        and row["finalized_before_payload_postreads"] is True
+        and lifecycle["child_infrastructure_finalized_before_payload_postreads"] is True
+        and lifecycle["owned_fin_control_path"] == str(path)
+        and row["original_child_finalization_seconds"] == 5
+        and row["cycle_deadline_seconds"] == 90
+        and row["real_orders_sent"] == 0,
+        "ACTUAL_BOUND_NATIVE_CLI_OWNED_FIN_CONTROL_REQUIRED")
+    gov.require(finalization["status"] == "GREEN"
+        and finalization["finalization_thread_finished"] is True
+        and finalization["management_bound_seconds"] == 5
+        and bounded_number(finalization["wall_seconds"], 5)
+        and finalization["kernel_echild_before_phase_return"] is True
+        and finalization["signal_guard_installed_and_witnessed"] is True
+        and finalization["forced_termination_attempted"] is False
+        and finalization["signal_vetoed"] is False
+        and finalization["forced_termination"] is False
+        and finalization["termination_signal_attempts"] == finalization["errors"] == [],
+        "NATIVE_FIVE_SECOND_FIN_UNKNOWN_PAYLOAD_VETO")
+    gov.require(lifecycle["fresh_infrastructure_verified"] is True
+        and set(lifecycle["infrastructure_before"]) == {"resource_tracker_pid", "resource_tracker_fd", "forkserver_alive_fd", "forkserver_pid"}
+        and all(value is None for value in lifecycle["infrastructure_before"].values())
+        and lifecycle["original_inet_operation_audit_registration_witness_verified"] is True
+        and lifecycle["inet_socket_attempts"] == []
+        and lifecycle["unexpected_error"] is None
+        and lifecycle["offline_ipv6_creation_capability"]["status"] == "INSTALLED_AND_KERNEL_WITNESSED"
+        and lifecycle["offline_ipv6_creation_capability"]["transitive_kernel_network_attestation"] is False,
+        "ORIGINAL_NATIVE_CLI_INFRASTRUCTURE_RED_PAYLOAD_VETO")
+    gov.require(row["cli_exit_code"] == lifecycle["cli_exit_code"] == kernel["returncode"]
+        and row["native_resource_exit_code"] == lifecycle["native_resource_exit_code"]
+        and type(row["cli_exit_code"]) is int and row["cli_exit_code"] in (0, 1)
+        and type(row["native_resource_exit_code"]) is int and row["native_resource_exit_code"] in (0, 1),
+        "NATIVE_CLI_LOGICAL_EXIT_CONTEXT_REBOUND")
+    return {"control": row, "sha256": hashlib.sha256(wire).hexdigest(), "stat_fields": attributes,
+        "original_native_five_second_FIN_closed": True,
+        "Source_DATA_result_log_payload_reads_before_this_control": 0}
