+        result = native_control(tmp_path, legacy=False, case='simpleExit')
+        assert result['main_phase_owned_fin_closed'] is result['main_phase_green'] is True
+        assert unrelated.poll() is None
+    finally:
+        unrelated.stdin.close()  # Natural EOF, no signal and no unrelated reap.
+        assert unrelated.wait() == 0
+
+
+def test_native_guard_still_rejects_a_real_live_own_child():
+    # This negative control is itself exclusive; it does not inspect or mutate
+    # the pytest process's other children or weaken wait4(-1, WNOHANG).
+    code = r"""
+import json, os, runpy, sys
+manager = runpy.run_path(sys.argv[1])
+initial = manager['pre_capture_kernel_state']()
+reader, writer = os.pipe()
+ready_reader, ready_writer = os.pipe()
+pid = os.fork()
+if pid == 0:
+    os.close(writer); os.close(ready_reader)
+    os.write(ready_writer, b'R'); os.close(ready_writer)
+    os.read(reader, 1); os.close(reader)
+    os._exit(0)
+os.close(reader); os.close(ready_writer)
+assert os.read(ready_reader, 1) == b'R'; os.close(ready_reader)
+try:
+    try:
+        manager['pre_capture_kernel_state']()
+    except ValueError as error:
+        assert str(error) == 'PRE_SOURCE_OWN_CHILD_PRESENT:0'
+        rejected = True
+    else:
+        raise AssertionError('LIVE_OWN_CHILD_MUST_REMAIN_FORBIDDEN')
+finally:
+    os.close(writer)
+    reaped, status, usage = os.wait4(pid, 0)
+    assert reaped == pid and os.waitstatus_to_exitcode(status) == 0
+final = manager['pre_capture_kernel_state']()
+assert final['subreaper_state_after'] == initial['subreaper_state_after']
+print(json.dumps({'live_own_child_rejected': rejected, 'child_reaped': reaped == pid,
+                  'kernel_echild_verified': final['kernel_echild_verified']}))
+"""
+    completed = subprocess.run([sys.executable, '-I', '-B', '-c', code,
+        str(ROOT / workspace.DRIVER)], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        text=True, check=True, env=dict(os.environ, PYTHONDONTWRITEBYTECODE='1'))
+    assert json.loads(completed.stdout) == {'live_own_child_rejected': True,
+        'child_reaped': True, 'kernel_echild_verified': True}
