schema_version: 2
test_governance:
  automatic_discovery_required: true
  manual_test_file_allowlist_as_primary_ci: false
  new_test_must_be_discovered_automatically: true
  silent_exclusion_allowed: false
  current_contract_tests_block_predeploy: true
  legacy_regressions:
    explicit_classification_required: true
    reason_required: true
    successor_or_preserved_intent_required: true
  brittle_assertions:
    workflow_text_occurrence_counts_allowed: false
    ui_literal_text_should_be_semantic_when_possible: true
  failure_handling:
    delete_test_to_get_green: false
    xfail_without_reason: false
    known_failure_requires_triage: true
    product_defect_must_be_distinguished_from_test_contract_drift: true

# This is the single productive test scope consumed by Predeploy V2.  Passing
# the repository root to pytest makes every current or future test_*.py file
# enter collection automatically.  Exclusions are paths, never test allowlists.
productive_scope:
  runner: pytest
  roots:
    - .
  python_files: test_*.py
  report:
    junit_xml: /tmp/porota-governed-tests.xml
    evidence_json: /tmp/porota-governed-tests.json
  exclusions:
    - path: test_a3_primary_readonly_hf6.py
      classification: SUPERSEDED_DUPLICATE_MODULE
      reason: >-
        The repository-root module has the same import name as the current
        tests/test_a3_primary_readonly_hf6.py contract and prevents pytest
        collection with an import-file-mismatch error.
      successor: tests/test_a3_primary_readonly_hf6.py
      owner: WS-INFRA-05
