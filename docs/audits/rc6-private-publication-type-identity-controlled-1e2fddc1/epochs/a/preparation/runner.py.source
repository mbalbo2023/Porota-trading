MAX_MOUNTINFO = 4 * 1024**2
MAX_TAR = 512 * 1024**2
MAX_FOCAL_RSS = 2 * 1024**3
IPV6_PROBE_PATH = "/workspace/venv_rc6_frozen311/lib/python3.11/site-packages/urllib3/util/connection.py"
IPV6_PROBE_FILE_SHA = "2633bbdb69731e5ccb5cf4e4afd65605d86c7979cc5633126f50c92d5ad74a74"
