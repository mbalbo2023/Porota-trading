SOURCE_TREE = "b984539931a25a5f77eae55116c4fa9543d53748"
SUPPORT_SHA = "f4e99413c0e933e7a7468156c6fea937790fcdda15f1e772e99ea7fd71b50a21"
INTERPRETER = "/workspace/venv_rc6_frozen311/bin/python"
MODULES = (
