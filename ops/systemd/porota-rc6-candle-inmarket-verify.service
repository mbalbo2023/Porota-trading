[Unit]
Description=Porota RC6 intramarket candle read-only evidence
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
Environment=PYTHONPATH=/opt/porota-trading
# Existing 10-minute cursor evidence only: OPEN or COM19031 source-only T+1.
# This does not permit any new orders, readers or market-data GETs.
ExecCondition=/usr/bin/python3 /opt/porota-trading/scripts/rc6_source_cycle_dispatch.py --check-phase candle_observation
ExecStart=/usr/local/sbin/porota-rc6-candle-inmarket-verify
NoNewPrivileges=true
PrivateTmp=true
