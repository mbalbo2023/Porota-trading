[Unit]
Description=Porota RC6 intramarket candle evidence every ten minutes

[Timer]
# Proof of live candles belongs to the audited trading session only.
OnCalendar=Mon..Fri *-*-* 10:40,50:00 America/Argentina/Buenos_Aires
OnCalendar=Mon..Fri *-*-* 11..16:00/10:00 America/Argentina/Buenos_Aires
Persistent=false
Unit=porota-rc6-candle-inmarket-verify.service

[Install]
WantedBy=timers.target
