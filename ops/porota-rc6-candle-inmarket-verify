# RC6 intramarket-candle evidence wrapper. Runs only local Docker read-only query.
set -Eeuo pipefail
SUMMARY_PATH=/app/data/validation/candle_inmarket_latest.json

exec /usr/bin/docker exec -i porota_production_observer \
  python /app/scripts/rc6_candle_inmarket_evidence.py \
  --summary-path "$SUMMARY_PATH"
