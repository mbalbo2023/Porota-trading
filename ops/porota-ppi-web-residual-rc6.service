[Unit]
Description=Porota RC6 PPI Web residual historical completion
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/opt/porota-ingest/ppi-web-residual/ENABLED

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/porota-trading
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/porota-trading:/opt/porota-ingest/ppi-web-residual/bin
Environment=PPI_WEB_RESIDUAL_RUN_ID=PPI-WEB-RESIDUAL-20260913-001
Environment=PPI_WEB_RESIDUAL_ROOT=/opt/porota-ingest/ppi-web-residual
Environment=PPI_WEB_BROWSER_USER=porotaadmin
Environment=PPI_WEB_PROFILE=/home/porotaadmin/porota-browser-lab/chrome-profile
Environment=PPI_WEB_SECRET=/etc/porota/contract-evidence-web.env
Environment=PPI_WEB_PYTHON=/opt/porota-contract-evidence-venv/bin/python
Environment=PPI_WEB_COLLECTOR=/opt/porota-ingest/ppi-web-residual/bin/rc6_ppi_web_history_shadow.py
Environment=PPI_WEB_REAUTH=/opt/porota-ingest/ppi-web-residual/bin/rc6_ppi_web_reauth.py
Environment=PPI_HISTORY_API_UNIT=porota-ppi-fullfamily-history-rc6.service
ExecStart=/usr/bin/flock -n /run/lock/porota-ppi-web-residual-rc6.lock /opt/porota-contract-evidence-venv/bin/python /opt/porota-ingest/ppi-web-residual/bin/ppi_web_residual_server_runner_rc6.py
Restart=on-failure
RestartSec=30s
TimeoutStopSec=90s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/porota-ingest/ppi-web-residual /opt/porota-trading/data /home/porotaadmin/porota-browser-lab/chrome-profile

[Install]
WantedBy=multi-user.target
