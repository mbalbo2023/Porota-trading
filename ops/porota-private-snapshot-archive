#!/usr/bin/env bash
set -Eeuo pipefail
PHASE="${1:-}"
SRC="/opt/porota-trading/data/paper_v17/snapshots/latest.json"
DIR="/opt/porota-trading/data/paper_v17/snapshots"
ARCH="${DIR}/archive"

case "$PHASE" in
  preopen|postclose) ;;
  *) exit 0 ;;
esac
[ -s "$SRC" ] || exit 0

/usr/bin/python3 - "$SRC" "$PHASE" <<'PY'
import json, sys
value=json.load(open(sys.argv[1], encoding="utf-8"))
raise SystemExit(0 if value.get("phase")==sys.argv[2] and value.get("schema_version")==1 else 3)
PY

mkdir -p "$ARCH"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
TMP="${DIR}/.${PHASE}_latest.$$"
cp --preserve=mode,timestamps "$SRC" "$TMP"
mv -f "$TMP" "${DIR}/${PHASE}_latest.json"
cp --preserve=mode,timestamps "$SRC" "${ARCH}/${PHASE}_${STAMP}.json"
