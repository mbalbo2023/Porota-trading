{
  "schema": "RC6_DYNAMIC_CAPACITY_POLICY_V1",
  "version": "rc6-capacity-runtime-v1",
  "mode": "OFF",
  "mode_safety": "PAPER_SHADOW_ONLY",
  "max_parallel_requests": 1,
  "safety_factor": 0.75,
  "baseline_limits": {"EQUITY_SPOT": 20, "SCALPING": 40},
  "engines": {
    "SCALPING": {
      "endpoints": ["intraday", "book"],
      "hot_seconds": 30,
      "warm_seconds": 120,
      "discovery_seconds": 300,
      "warmup_samples": 15,
      "window_seconds": 2700,
      "max_age_seconds": 120
    },
    "EQUITY_SPOT": {
      "endpoints": ["current", "book"],
      "hot_seconds": 120,
      "warm_seconds": 300,
      "discovery_seconds": 600,
      "warmup_samples": 6,
      "window_seconds": 5400,
      "max_age_seconds": 120
    }
  },
  "budget": {
    "critical_book_seconds": 5,
    "lease_seconds": 60,
    "breaker_seconds": 60,
    "session_breaker_seconds": 900,
    "server_error_threshold": 2,
    "maximum_bytes": 8388608
  }
}
