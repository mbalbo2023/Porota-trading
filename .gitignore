# ============================================================================
# .gitignore — Porota Trading v16.2
# ============================================================================
# El patrón .env solo excluía UN nombre de archivo. Cualquier variante
# (.env.testing, .env.produccion, .env.bak) entraba al repositorio sin que
# nada avisara. Ahora se excluye la familia entera y se admite una sola
# excepción explícita: la plantilla sin valores.
.env
.env.*
!.env.example

# Datos operativos y estado en runtime
data/
sre_vector_db/
model_cache/
*.db
*.db-wal
*.db-shm
*.log

# Artefactos fuera del paquete (se entregan aparte, nunca se versionan)
Secret.txt
ACCESO_DASHBOARD_DROPLET.txt

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
venv/
.venv/
.secrets/
data/observer/

:memory:*
*.ses
*.bak
*.pre-hf6*
**/*.bak
**/*.pre-hf6*
