[Unit]
Description=Porota RC6 phase-gated IOL/public 1m / universe evidence 5m
Wants=network-online.target
After=network-online.target
ConditionPathExists=/root/.config/porota/iol_mcp_oauth_bootstrap.json

[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
Environment=POROTA_IOL_SHADOW_MODE=OBSERVE_ONLY
Environment=POROTA_IOL_SHADOW_SCOPE=AUDIT_ALL
Environment=POROTA_IOL_SHADOW_ROOT=/opt/porota-trading/data/market
Environment=PYTHONPATH=/opt/porota-trading
ExecStart=/usr/bin/python3 /opt/porota-trading/scripts/rc6_source_cycle_dispatch.py
TimeoutStartSec=210s
NoNewPrivileges=true
PrivateTmp=true
