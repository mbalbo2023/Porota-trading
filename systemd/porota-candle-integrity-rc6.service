[Unit]
Description=Porota RC6 candle integrity read-only audit
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
Environment=PYTHONPATH=/opt/porota-trading
ExecCondition=/usr/bin/python3 /opt/porota-trading/scripts/rc6_source_cycle_dispatch.py --check-phase business_day
ExecStart=/usr/bin/docker exec porota_production_observer python /app/rc6_candle_integrity.py
TimeoutStartSec=3min
