[Unit]
Description=Porota RC6 A3 historical background (%i) — read-only source, no order routing
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
ExecStart=/usr/bin/docker exec -e A3_HISTORY_MODE=%i porota_production_observer python /app/ex_a3_history_job_rc6.py %i
TimeoutStartSec=3600
