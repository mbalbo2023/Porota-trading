[Unit]
Description=Porota RC6 functional introspection
After=docker.service
Wants=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/porota-introspection-rc6.sh
SuccessExitStatus=2
TimeoutStartSec=180
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
