[Unit]
Description=Porota RC6 post-close History Store reconciliation
After=docker.service
Requires=docker.service
# Quarantined by default. A separate, explicitly authorized recovery project\n# must create this file before the unit can run.\nConditionPathExists=/etc/porota/rc6-postclose-history-explicitly-authorized\n
[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
ExecStart=/usr/bin/docker exec porota_production_observer python /app/rc6_postclose_history_job.py
TimeoutStartSec=20min
