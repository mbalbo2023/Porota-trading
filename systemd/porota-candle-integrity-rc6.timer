[Unit]
Description=Porota RC6 candle integrity staggered intramarket plus postclose

[Timer]
# This scans candle versions; the independent inmarket freshness verifier owns
# the ten-minute cadence. Never scan the closed HOT SQLite every ten minutes.
OnCalendar=Mon..Fri *-*-* 10:35:00 America/Argentina/Buenos_Aires
OnCalendar=Mon..Fri *-*-* 11..16:05,35:00 America/Argentina/Buenos_Aires
# COM19031 02-Nov: T+1 equities/CEDEARs remain observable 17:00..18:00.
# Two additional bounded semantic audits cover that interval; 18:05 is not
# a final closing-price/EOD receipt (official postclose can extend to 18:15).
OnCalendar=Mon..Fri *-*-* 17:05,35:00 America/Argentina/Buenos_Aires
OnCalendar=Mon..Fri *-*-* 18:05:00 America/Argentina/Buenos_Aires
OnCalendar=Mon..Fri *-*-* 23:45:00 America/Argentina/Buenos_Aires
Persistent=false
AccuracySec=30s
Unit=porota-candle-integrity-rc6.service

[Install]
WantedBy=timers.target
