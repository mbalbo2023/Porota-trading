[Unit]
Description=Porota RC6 fast functional health (read-only, no full DB scan)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
ExecStart=/usr/bin/docker exec porota_production_observer python /app/rc6_fast_functional_health.py
TimeoutStartSec=30s
