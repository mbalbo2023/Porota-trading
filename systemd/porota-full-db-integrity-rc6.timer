[Unit]
Description=Porota RC6 full DB integrity once postclose on weekdays

[Timer]
# The EOD incremental copy can run until 22:55. Do not scan the full HOT DB
# while the cold-store writer is draining or while the 23:45 candle audit runs.
OnCalendar=Mon..Fri *-*-* 23:20:00 America/Argentina/Buenos_Aires
Persistent=false
RandomizedDelaySec=120
Unit=porota-full-db-integrity-rc6.service

[Install]
WantedBy=timers.target
