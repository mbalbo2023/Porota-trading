[Unit]
Description=Porota RC6 public sanitized PAPER snapshot endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/porota-trading
ExecStart=/usr/bin/python3 /opt/porota-trading/rc6_public_snapshot_server.py --bind 0.0.0.0 --port 8089
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/porota-trading/data/paper_v17/snapshots

[Install]
WantedBy=multi-user.target
