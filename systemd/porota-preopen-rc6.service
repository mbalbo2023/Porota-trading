[Unit]
Description=Porota RC6 read-only preopen fail-closed readiness
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
ExecStart=/usr/bin/python3 /opt/porota-trading/rc6_preopen.py --publish-paper-gate
# Bound the 10:15 check so it cannot still occupy this oneshot at the
# binding 10:20 gate. A timeout is fail-closed; no PAPER GO is published.
TimeoutStartSec=3min
