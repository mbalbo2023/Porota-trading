[Unit]
Description=Porota RC6 post-close operational snapshot (read-only)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/porota-trading
ExecStart=/bin/bash -c '/usr/bin/docker exec porota_production_dashboard python /app/rc6_snapshot.py --phase postclose && /usr/bin/docker exec porota_production_dashboard python /app/rc6_postclose_review.py'
TimeoutStartSec=2min
