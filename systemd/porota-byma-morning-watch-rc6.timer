[Unit]
Description=Porota RC6 BYMA authority watch at 08:30 Argentina on weekdays

[Timer]
OnCalendar=Mon..Fri *-*-* 08:30:00 America/Argentina/Buenos_Aires
AccuracySec=30s
# A missed 08:30 preopen source snapshot is not a postclose/nightly job.
# Never replay a missed market-data scrape when a held timer is restored.
Persistent=false
Unit=porota-byma-morning-watch-rc6.service

[Install]
WantedBy=timers.target
