[Unit]
Description=Porota RC5 Contract Evidence read-only evidence refresh
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/porota/contract-evidence-rc5.env
ConditionPathExists=/usr/local/sbin/porota-contract-evidence-rc5-runtime.sh

[Service]
Type=oneshot
EnvironmentFile=/etc/porota/contract-evidence-rc5.env
ExecStart=/usr/local/sbin/porota-contract-evidence-rc5-runtime.sh
TimeoutStartSec=20min
TimeoutStopSec=2min
Nice=10
UMask=0077
