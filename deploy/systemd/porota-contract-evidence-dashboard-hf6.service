[Unit]
Description=Restore Porota HF6 contract evidence dashboard overlay
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/porota-contract-evidence-dashboard-overlay-hf6.sh
TimeoutStartSec=5min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
