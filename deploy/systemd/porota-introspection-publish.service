[Unit]
Description=Porota sanitized introspection publication
After=docker.service porota-introspeccion-hf5.service
Wants=docker.service

[Service]
Type=oneshot
User=porotaadmin
Group=porotaadmin
SupplementaryGroups=docker
RuntimeDirectory=porota-introspection-publish
RuntimeDirectoryMode=0750
ExecStart=/opt/porota-trading/scripts/porota_publish_introspection_github_hf6.sh
TimeoutStartSec=180
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/porota-trading/data/introspection_publish /var/lib/porota-observability /run/porota-introspection-publish

[Install]
WantedBy=multi-user.target
