[Unit]
Description=Porota HF6 sanitized runtime log export
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=porotaadmin
Group=porotaadmin
WorkingDirectory=/opt/porota-trading
ExecStart=/opt/porota-trading/scripts/porota_export_runtime_logs_hf6.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/porota-trading/data/logs /run/lock

[Install]
WantedBy=multi-user.target
