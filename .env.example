# Porota Trading - example environment variables
# Copy to .env locally/Codespaces and fill in real values. Never commit secrets.

# Application
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=America/Argentina/Buenos_Aires

# PPI / broker API
PPI_API_BASE_URL=
PPI_USERNAME=
PPI_PASSWORD=
PPI_CLIENT_ID=
PPI_CLIENT_SECRET=
PPI_ACCESS_TOKEN=

# Gemini
GEMINI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database / cache (only if required by the final application)
DATABASE_URL=
REDIS_URL=

# Monitoring
PROMETHEUS_PORT=9090

# Reporting
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf
