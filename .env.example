# Porota Trading — plantilla de variables de entorno
# Copiá este archivo como .env y completá los valores.
# Se genera desde v_config_metadata.py, la única fuente de verdad.

# ----------------------------------------------------------
# Credenciales
# ----------------------------------------------------------
# Usuario técnico para operar tu cuenta de PPI.
PPI_API_KEY=

# Contraseña técnica de PPI.
PPI_API_SECRET=

# Tu número de cuenta en PPI.
PPI_ACCOUNT_NUMBER=12345678

# SANDBOX (práctica) o PRODUCTION (plata real).
ENVIRONMENT=SANDBOX

# Llave de Google AI Studio para el motor de IA.
GEMINI_API_KEY=

# Modelo de Gemini a usar.
# v16.2 - DEJAR VACIO. Vacio significa: usar el mejor modelo disponible
# segun el catalogo descubierto en runtime (Pro primero, despues Flash).
# Fijar un ID aca ANULA el descubrimiento dinamico y vuelve al problema que
# rompio versiones anteriores: el dia que el proveedor retire ese modelo, el
# sistema se queda sin motor. Los tres modelos que estaban fijados aca
# (serie 2.5) tienen fecha de apagado anunciada para octubre de 2026.
GEMINI_MODEL=

# Token del bot de Telegram (BotFather).
TELEGRAM_BOT_TOKEN=

# A qué chat de Telegram mandar los avisos.
TELEGRAM_CHAT_ID=987654321

# Opcional — respaldo si Gemini falla (motor Claude). Vacío = desactivado.
ANTHROPIC_API_KEY=

# Modelo de Claude para el respaldo.
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5

# Opcional — fallback de headers para Sandbox. Vacío = comportamiento normal (recomendado salvo que soporte de PPI confirme que hace falta).
PPI_CLIENT_ID=

# Opcional — ver PPI_CLIENT_ID. Vacío = comportamiento normal.
PPI_CLIENT_KEY=

# ----------------------------------------------------------
# Horarios
# ----------------------------------------------------------
# Hora de apertura de rueda (0-23, hora Argentina).
MARKET_OPEN_HOUR=11

# Hora de cierre de rueda.
MARKET_CLOSE_HOUR=17

# Zona horaria del servidor.
SERVER_TIMEZONE=America/Argentina/Buenos_Aires

# ----------------------------------------------------------
# Riesgo
# ----------------------------------------------------------
# % de tu cuenta que se arriesga por operación.
RISK_PCT_PER_TRADE=1.0

# Distancia del stop-loss, en unidades de volatilidad (ATR).
STOP_LOSS_ATR_MULT=1.0

# Distancia del take-profit, en unidades de ATR.
TAKE_PROFIT_ATR_MULT=2.0

# Operaciones simultáneas permitidas.
MAX_OPEN_POSITIONS=3

# % máximo de la profundidad del libro por orden.
MAX_PCT_OF_BOOK_DEPTH=10.0

# Días esperados de tenencia, para prorratear el hurdle.
TARGET_HOLD_DAYS=5

# ----------------------------------------------------------
# Kill switch
# ----------------------------------------------------------
# % de pérdida diaria que corta las alertas nuevas.
MAX_DAILY_LOSS_PCT=1.0

# % de caída desde el máximo que corta las alertas.
MAX_DRAWDOWN_PCT=5.0

# Pérdidas seguidas que activan el corte.
MAX_CONSECUTIVE_STOP_LOSSES=3

# % que el CCL puede moverse en el día antes de cortar.
CCL_INTRADAY_CIRCUIT_BREAKER_PCT=3.0

# % máximo del capital total en un mismo ticker.
MAX_EXPOSURE_PER_TICKER_PCT=40.0

# ----------------------------------------------------------
# Costos y hurdle
# ----------------------------------------------------------
# Comisión de PPI por tramo.
PPI_COMMISSION_PCT=0.006

# IVA sobre la comisión.
IVA_PCT=0.21

# Derecho de mercado de BYMA.
BYMA_FEE_PCT=0.0008

# Extra de exigencia sobre el piso de inflación/devaluación.
DEFAULT_RISK_PREMIUM_PCT=1.5

# Archivo con el dato de inflación mensual.
MACRO_CONFIG_PATH=a_macro_config.json

# Días antes de tratar el dato de inflación como vencido.
MACRO_CONFIG_MAX_AGE_DAYS=45

# Piso conservador si el dato está vencido.
MACRO_CONFIG_STALE_FALLBACK_PCT=8.0

# Fuentes macro históricas públicas. BCRA v4 reemplazó a v3, desactivada en 2026.
MACRO_HISTORY_ENABLED=true
MACRO_REFRESH_HOURS=12
MACRO_LOOKBACK_DAYS=365
MACRO_HTTP_TIMEOUT=8
BCRA_MONETARIAS_VERSION=v4.0

# IDs verificados en el catálogo oficial BCRA v4. TAMAR privada TNA (44)
# reemplaza como referencia vigente a la tasa de política monetaria, cuya
# serie finalizó el 10/07/2025. No son credenciales.
BCRA_ID_RESERVAS=1
BCRA_ID_TAMAR_PRIVADOS_TNA=44
BCRA_ID_BASE_MONETARIA=15

# Costo fijo mensual del servidor (informativo).
MONTHLY_FIXED_COSTS_ARS=0

# Dónde se persiste el factor de ajuste dinámico de comisiones.
FEE_STRESS_STATE_PATH=data/fee_stress_state.json

# ----------------------------------------------------------
# Ejecución
# ----------------------------------------------------------
# 'auto' (sin botón, ejecuta directo — default en SANDBOX) o 'confirm' (botón en Telegram — default en PRODUCTION). Vacío = automático según ENVIRONMENT.
ORDER_EXECUTION_MODE=auto

# Interruptor extra si PRODUCTION + ORDER_EXECUTION_MODE=auto a la vez.
PRODUCTION_AUTO_EXECUTE_CONFIRMED=false

# Minutos para confirmar antes de que la propuesta venza (modo confirm).
ORDER_CONFIRMATION_TIMEOUT_MINUTES=10

# % máximo que el precio puede moverse antes de ejecutar/confirmar.
PRICE_REVALIDATION_TOLERANCE_PCT=1.0

# Cada cuántos segundos se revisan los botones de Telegram (modo confirm).
POLL_CONFIRMATIONS_INTERVAL_SECONDS=4

# Segundos que se reintenta una orden PartiallyFilled antes de aceptar el remanente.
PARTIAL_FILL_POLL_SECONDS=20

# Frecuencia de reconsulta mientras una orden está PartiallyFilled.
PARTIAL_FILL_POLL_INTERVAL_SECONDS=2

# ----------------------------------------------------------
# Scalping
# ----------------------------------------------------------
# Activa marcos 1M/5M y horizonte en minutos, solo para CEDEARs.
# ACTIVADO EN v16.2 por pedido explicito. El validador de costos de mas
# abajo es la contraparte obligatoria: frena las entradas nuevas si el
# margen neto real de las ultimas operaciones cortas viene negativo.
SCALPING_MODE=true

# Minutos de mantenimiento esperado de una posición en modo scalping.
SCALPING_TARGET_HOLD_MINUTES=30

# Segundos de pausa entre instrumentos en modo scalping.
SCALPING_SCAN_INTERVAL_SECONDS=10

# Días hacia atrás para el win rate mostrado en cada ejecución automática.
WIN_RATE_LOOKBACK_DAYS=30

# Frena nuevas entradas de scalping si el margen neto real reciente viene negativo.
SCALPING_COST_VALIDATOR_ENABLED=true

# Margen neto mínimo (%) exigido en las últimas operaciones de scalping.
MIN_SCALPING_NET_MARGIN_PCT=0.5

# ----------------------------------------------------------
# Universo de instrumentos
# ----------------------------------------------------------
# El bot descubre instrumentos operables solo (true) o usa solo la watchlist (false).
AUTO_DISCOVER_INSTRUMENTS=true

# También descubre opciones/futuros/cauciones/FCI, solo para mostrar (no operar).
AUTO_DISCOVER_ALL_TYPES=true

# Tope de instrumentos descubiertos por tipo.
MAX_DISCOVERED_PER_TYPE=40

# Volumen promedio mínimo (pesos) para analizar un instrumento.
MIN_LIQUIDITY_ARS=5000000

# Archivo con la watchlist de respaldo.
INSTRUMENT_WATCHLIST_PATH=n_instrument_watchlist.json

# Fuente primaria del análisis técnico de CEDEARs: yfinance o ppi.
TECHNICAL_DATA_SOURCE_CEDEARS=yfinance

# Descargas de velas en paralelo (solo contra yfinance, nunca contra PPI).
TECHNICAL_MAX_WORKERS=6

# Segundos que se reutiliza una descarga de velas dentro de la misma vuelta de escaneo.
TECHNICAL_CACHE_SECONDS=45

# ----------------------------------------------------------
# Aprendizaje
# ----------------------------------------------------------
# Operaciones cerradas mínimas para permitir el ajuste mensual.
MIN_SAMPLE_SIZE_AUTOTUNE=30

# Días que se conservan las filas de la tabla signals antes de podarse (mensual, junto al auto-tuning). No afecta closed_trades/learning_diagnostics.
SIGNALS_RETENTION_DAYS=365

# Días que se conservan los titulares de noticias en bruto (daily_headlines, global_news_247) antes de podarse.
NEWS_ARCHIVE_RETENTION_DAYS=90

# Cuánto puede cambiar un umbral en un ajuste mensual.
MAX_PARAM_CHANGE_PCT=10

# Umbral técnico de arranque.
DEFAULT_MIN_SCORE_TECH=0.70

# Umbral macro de arranque.
DEFAULT_MIN_SCORE_MACRO=0.70

# ----------------------------------------------------------
# Backtest
# ----------------------------------------------------------
# Capital ficticio de arranque en cada simulación.
BACKTEST_INITIAL_CAPITAL_ARS=1000000

# Días máximos antes de cerrar una operación simulada a la fuerza.
BACKTEST_MAX_HOLD_DAYS=10

# Spread supuesto al simular, para no sobreestimar el resultado histórico.
BACKTEST_ASSUMED_SPREAD_PCT=0.2

# ----------------------------------------------------------
# Dashboard y técnico
# ----------------------------------------------------------
# Puerto del panel web.
DASHBOARD_PORT=8000

# Contraseña simple para entrar al dashboard (preferí mandarla como header Authorization: Bearer, no en la URL).
# Token para acceso PROGRAMATICO (scripts, healthchecks). 32 caracteres o
# mas, aleatorios. El panel NO ARRANCA si esta vacio: fallar cerrado.
#   python -c "import secrets;print(secrets.token_urlsafe(36))"
DASHBOARD_ACCESS_TOKEN=

# 127.0.0.1 (default, solo accesible desde el servidor) o 0.0.0.0 (accesible desde internet).
# v16.2 - 0.0.0.0 DENTRO del contenedor. No es un relajamiento: con
# 127.0.0.1 la aplicacion escucha en el loopback DEL CONTENEDOR y el mapeo
# de puertos no puede alcanzarla, asi que el panel no abria desde ningun
# lado y el paso de salud del CI fallaba siempre. La seguridad la da el
# mapeo del compose (127.0.0.1:PUERTO:PUERTO) y el reverse proxy con TLS.
DASHBOARD_HOST=0.0.0.0

# Vigencia del token anti-CSRF del editor de configuración.
CSRF_TOKEN_MAX_AGE_SECONDS=900

# Dónde vive el archivo de la base de datos (dentro de ./data para que sobreviva a un reinicio del contenedor Docker — CORREGIDO EN v13.0).
DB_PATH=data/trading_system.db

# Antigüedad máxima de una noticia (segundos).
NEWS_MAX_AGE_SECONDS=21600

# Freno de velocidad hacia la API de PPI.
PPI_MAX_REQUESTS_PER_SECOND=2

# Carpeta donde se guarda el log descargable desde el dashboard.
LOG_DIR=data/logs

# Carpeta donde el motor SRE guarda sus diagnósticos de crashes.
PROPOSALS_DIR=data/proposals

# Dominio propio para HTTPS automático con Caddy (vacío = sin HTTPS).
DASHBOARD_DOMAIN=

# Ruta del .env que lee/escribe el editor visual del dashboard.
ENV_FILE_PATH=.env

# Carpeta del índice vectorial (ChromaDB) del motor de introspección.
SRE_VECTOR_DB_PATH=./sre_vector_db

# Qué archivos indexa el motor SRE para diagnosticar crashes.
SRE_CODEBASE_GLOB=*.py

# Temperatura del modelo al diagnosticar un crash. Baja = más literal.
SRE_MODEL_TEMPERATURE=0.2

# Dónde deja el entrypoint el PID del proceso del bot.
J_MAIN_PID_FILE=data/j_main.pid

# ----------------------------------------------------------
# Infraestructura
# ----------------------------------------------------------
# Carpeta de backups diarios automáticos de la base.
BACKUP_DIR=data/backups

# Días que se conservan los backups antes de borrarse.
BACKUP_RETENTION_DAYS=30

# % de uso de disco a partir del cual el panel de Infraestructura marca alerta roja.
INFRA_DISK_WARN_PCT=85

# Horas sin backup antes de marcarlo atrasado en el dashboard.
BACKUP_MAX_AGE_HOURS_WARN=26

# ----------------------------------------------------------
# Multi-agente (LangGraph)
# ----------------------------------------------------------
# 'shadow' (observación, default) o 'gating' (puede rechazar operaciones reales — no activar sin revisar la evidencia acumulada).
LANGGRAPH_MODE=shadow

# ----------------------------------------------------------
# Robustez API PPI
# ----------------------------------------------------------
# Fallas de servidor/red consecutivas antes de abrir el Circuit Breaker.
CIRCUIT_FAILURE_THRESHOLD=5

# Segundos que el Circuit Breaker corta llamadas antes de probar de nuevo.
CIRCUIT_OPEN_COOLDOWN_SECONDS=60

# Colocación automática de liquidez ociosa en cauciones. Mantener en false hasta confirmar plazo/ticker contra Sandbox real.
CAUCIONES_AUTO_PLACEMENT=false

# ----------------------------------------------------------
# Tiempo real (streams PPI)
# ----------------------------------------------------------
# Activa los streams oficiales de PPI para precios en vivo. Si falla, el bot cae solo a polling HTTP.
PPI_STREAM_ENABLED=true

# Activa el stream de cuenta: avisos push de cambio de estado de las órdenes (incluye cantidad ejecutada real).
PPI_STREAM_ACCOUNT_ENABLED=true

# Antigüedad máxima de un precio en vivo antes de descartarlo y salir a pedirlo por HTTP.
PPI_STREAM_MAX_TICK_AGE_SECONDS=5

# Segundos sin recibir ningún tick antes de que llegue un aviso por Telegram.
PPI_STREAM_STALE_ALERT_SECONDS=120

# Tope de instrumentos suscritos al stream a la vez.
PPI_STREAM_MAX_SUBSCRIPTIONS=60

# Cada cuánto se controla que el stream siga recibiendo datos.
PPI_STREAM_WATCHDOG_INTERVAL_SECONDS=60

# ----------------------------------------------------------
# Cierre de fin de día
# ----------------------------------------------------------
# Cierra a mercado las posiciones intradía antes de la campana, para no quedar expuesto de un día para otro.
EOD_CLOSE_ENABLED=true

# Cuántos minutos antes del cierre de rueda se ejecuta ese cierre forzado.
EOD_CLOSE_MINUTES_BEFORE=5

# true = cierra TODAS las posiciones, no solo las intradía. Dejar en false salvo que no quieras mantener nada de un día para otro.
EOD_CLOSE_ALL_POSITIONS=false

# ----------------------------------------------------------
# Seguridad y reinicio
# ----------------------------------------------------------
# Minutos durante los que queda disponible el botón de reinicio después de guardar un cambio real.
ENV_CHANGE_REQUEST_WINDOW_MINUTES=15

# Minutos para confirmar el reinicio por Telegram antes de que la solicitud venza.
ENV_RESTART_CONFIRM_TIMEOUT_MINUTES=10

# Cada cuánto revisa el bot si hay un reinicio confirmado esperando que el sistema quede libre.
RESTART_CHECK_INTERVAL_SECONDS=30

# Antigüedad tras la cual un aviso de 'operación en curso' se considera basura de un proceso caído y deja de bloquear el reinicio.
ACTIVITY_LOCK_MAX_AGE_SECONDS=300

# ----------------------------------------------------------
# Vigilancia de logs
# ----------------------------------------------------------
# Manda a Telegram, solo, lo que aparezca en los logs y amerite tu atención.
LOG_WATCH_ENABLED=true

# Cada cuántos minutos se revisan las líneas nuevas del log.
LOG_WATCH_INTERVAL_MINUTES=30

# Tiempo mínimo antes de volver a avisar por el MISMO tipo de error (anti-spam).
LOG_WATCH_REPEAT_SUPPRESS_MINUTES=60

# Dónde se guarda hasta qué punto del log ya se revisó (para no releer lo mismo).
LOG_WATCH_STATE_PATH=data/log_watch_state.json

# Cuántos tipos distintos de error como máximo entran en un mismo aviso de Telegram.
LOG_WATCH_MAX_SIGNATURES_PER_MESSAGE=6

# ----------------------------------------------------------
# AIOps (detección de anomalías)
# ----------------------------------------------------------
# Activa el vigilante que detecta comportamiento anómalo del propio bot (latencia, memoria, slippage).
AIOPS_ENABLED=true

# Cada cuántos segundos toma una muestra de métricas.
AIOPS_POLL_INTERVAL_SECONDS=60

# Proporción esperada de muestras anómalas (parámetro del Isolation Forest). Más alto = más sensible.
AIOPS_CONTAMINATION=0.05

# Muestras mínimas antes de empezar a detectar de verdad.
AIOPS_MIN_TRAINING_SAMPLES=50

# Cada cuántas muestras se reentrena el modelo con el historial reciente.
AIOPS_RETRAIN_EVERY_N_SAMPLES=200

# Latencia considerada normal hacia PPI, para el arranque en frío del modelo.
AIOPS_NORMAL_LATENCY_MS=400

# Memoria considerada normal del proceso, para el arranque en frío.
AIOPS_NORMAL_RAM_MB=300

# Slippage considerado normal, para el arranque en frío.
AIOPS_NORMAL_SLIPPAGE_PCT=0.1

# ----------------------------------------------------------
# Arranque
# ----------------------------------------------------------
# Si el bot pide autorización por Telegram antes de operar. En true no arranca solo.
STARTUP_REQUIRE_AUTH=true

# Minutos que espera la autorización antes de quedar detenido sin operar.
STARTUP_TIMEOUT_MINUTES=60

# Dónde se guarda el estado del arranque (lo comparten el bot y el panel).
STARTUP_STATE_PATH=./data/startup_state.json

# Traza paso a paso que muestra la solapa de Testing.
TESTING_LOG_PATH=./data/testing_trace.jsonl

# ----------------------------------------------------------
# Derivados
# ----------------------------------------------------------
# Si se operan opciones y futuros. En false se descubren y se muestran, pero no se opera.
TRADE_DERIVATIVES=true

# Días mínimos hasta el vencimiento para entrar. Menos que esto, el decaimiento se come la ganancia.
DERIV_MIN_DAYS_TO_EXPIRY=15

# Días antes del vencimiento en que se cierra sí o sí, gane o pierda.
DERIV_FORCE_CLOSE_DAYS=3

# Distancia máxima del strike al precio del subyacente. Evita comprar opciones de lotería.
DERIV_MAX_MONEYNESS_PCT=15.0

# Prima máxima como % del subyacente. Una prima alta indica volatilidad implícita inflada.
DERIV_MAX_PREMIUM_PCT=12.0

# Spread máximo tolerado en el book del derivado.
DERIV_MAX_SPREAD_PCT=6.0

# Tope del capital total en derivados, sumando todo lo abierto.
DERIV_MAX_PORTFOLIO_PCT=20.0

# Lote a usar solo si la API no informa el real del contrato.
DERIV_DEFAULT_OPTION_LOT=100

# ----------------------------------------------------------
# Portón operativo
# ----------------------------------------------------------
# Minutos que se tolera operar sin noticias antes de dejar de abrir.
NEWS_BLACKOUT_MAX_MINUTES=90

# Antigüedad máxima de las series macro para que sirvan como contexto alternativo.
MACRO_CACHE_MAX_AGE_HOURS=36

# Cuánto se achica la posición cuando el contexto está degradado. 0.5 = la mitad.
DEGRADED_SIZE_FACTOR=0.5

# Cuánto se sube el piso de rentabilidad con contexto degradado.
DEGRADED_HURDLE_MULT=1.5

# Minutos antes del cierre en que se deja de abrir posiciones.
NO_OPEN_MINUTES_BEFORE_CLOSE=20

# Desfasaje de reloj tolerado antes de frenar todo.
CLOCK_DRIFT_MAX_SECONDS=120

# ----------------------------------------------------------
# Datos históricos
# ----------------------------------------------------------
# Activa el conector de Invertir Online. En false no se hace ninguna llamada.
IOL_ENABLED=false

# Usuario de IOL.
IOL_USERNAME=

# Contraseña de IOL.
IOL_PASSWORD=

# Tiempo máximo de espera por llamada a IOL.
IOL_TIMEOUT_SECONDS=12

# Pausa entre llamadas a IOL. Protege la cuota mensual.
IOL_RATE_LIMIT_SLEEP=0.25

# Archivo del histórico de precios.
HIST_DB_PATH=./data/market_history.db

# Días de historia que se bajan por instrumento.
HIST_DEFAULT_DAYS=365

# Mínimo de velas para que las métricas históricas tengan sentido.
HIST_MIN_DAYS_USABLE=90

# Pausa entre instrumentos durante la descarga masiva.
HIST_BATCH_SLEEP=0.25

# Diferencia con Yahoo a partir de la cual el precio de PPI se considera sospechoso.
DOBLE_CHEQUEO_UMBRAL_PCT=5.0

# Desfasaje de publicación del IPC. Evita que el backtest use datos del futuro.
MACRO_PUBLICATION_LAG_DAYS=20

# ----------------------------------------------------------
# Costos
# ----------------------------------------------------------
# Si los derechos de mercado tributan IVA. En true suman 0,0968% por tramo en vez de 0,08%.
BYMA_FEE_TAXED=true

# ----------------------------------------------------------
# Salud y SRE
# ----------------------------------------------------------
# Cuánto se cachea el resultado de las sondas de salud.
HEALTH_CACHE_SECONDS=60

# Latencia a partir de la cual una API se marca en amarillo.
HEALTH_SLOW_MS=2500

# Hora desde la que se pueden aplicar mejoras del SRE.
SRE_DEPLOY_WINDOW_START_HOUR=20

# Hora hasta la que se pueden aplicar mejoras.
SRE_DEPLOY_WINDOW_END_HOUR=22

# Vigencia del código de confirmación de Telegram.
SRE_CONFIRM_TTL_SECONDS=900

# Tiempo máximo de cada paso del autotest antes de darlo por fallido.
SRE_AUTOTEST_TIMEOUT=300

# Dónde se guardan los respaldos previos a cada cambio.
SRE_BACKUP_DIR=./data/sre_backups

# Dónde viven las propuestas de mejora del motor SRE.
PROPOSALS_DIR=./data/proposals

# ----------------------------------------------------------
# Comandos Telegram
# ----------------------------------------------------------
# Cada cuántos segundos se consultan comandos nuevos.
TELEGRAM_COMMAND_POLL_SECONDS=5

# Vigencia del código de confirmación de una parada de emergencia.
TELEGRAM_CONFIRM_TTL_SECONDS=300

# ----------------------------------------------------------
# Griegas
# ----------------------------------------------------------
# Tasa libre de riesgo de respaldo si no hay caución disponible. Se usa para despejar la volatilidad implícita.
GREEKS_RISK_FREE_DEFAULT=0.29

# ----------------------------------------------------------
# IA
# ----------------------------------------------------------
# Segundos máximos que se espera una decisión de la IA antes de pasar al respaldo.
GEMINI_TIMEOUT_SECONDS=15

# Exposición máxima por papel que el guardián posinferencia hace respetar.
MAX_TICKER_EXPOSURE_PCT=40

# ===========================================================================
# ACCESO AL PANEL - USUARIO Y CONTRASENA (nuevo en v16.2)
# ===========================================================================
# Hasta esta version el panel se protegia solo con un token. Funciona, pero
# una URL con el token adentro queda en el historial del navegador y en los
# logs de cualquier proxy, y no hay forma de saber quien entro.
#
# Ahora hay usuario y contrasena con sesion por cookie, y el token sigue
# existiendo para el acceso programatico. Los dos caminos cubren usos
# distintos: una persona con un navegador quiere una pantalla de login, un
# healthcheck de Docker quiere un encabezado.
DASHBOARD_USER=porota

# Contrasena en texto plano. SOLO PARA TESTING. Si esta presente con
# ENVIRONMENT=PRODUCTION, el sistema lo avisa en cada arranque.
DASHBOARD_PASSWORD=Porota2026-testing

# Contrasena hasheada (PBKDF2-HMAC-SHA256). Es la forma correcta en
# produccion: el .env lleva el hash, nunca la clave. Generarlo con:
#   python -c "import ay_dashboard_auth as a; print(a.hashear('tu-clave'))"
# Si esta definida, tiene prioridad sobre DASHBOARD_PASSWORD.
DASHBOARD_PASSWORD_HASH=

DASHBOARD_SESSION_HOURS=12
DASHBOARD_MAX_LOGIN_ATTEMPTS=5
DASHBOARD_LOCKOUT_MINUTES=15

# ===========================================================================
# MOTOR DE IA - SELECCION DINAMICA (nuevo en v16.2)
# ===========================================================================
# El sistema pregunta al proveedor que modelos existen AHORA y elige el mejor
# segun la politica de abajo, en vez de seguir una lista escrita en el codigo.
# Cuando el proveedor retire un modelo, el sistema se reacomoda solo.
MODEL_DISCOVERY_ENABLED=true

# Orden de preferencia por nivel. Pro primero: mejor razonamiento para juzgar
# lo que no se reduce a una formula (si el volumen del book es real, si una
# suba es del activo o del dolar, si un titular es ruido o es un evento).
MODEL_TIER_PREFERENCE=pro,flash,flash-lite

# Presupuesto de latencia por decision. Preferir el modelo mas capaz no sirve
# de nada si llega tarde a la rueda: si la latencia MEDIANA supera este
# numero, el sistema degrada a Flash y avisa. Se mira la mediana y no el
# promedio para que un pico de red no cambie el motor.
MODEL_LATENCY_BUDGET_SECONDS=12
MODEL_LATENCY_SAMPLES=10

# Cadena fija. DEJAR VACIO salvo que haya un motivo concreto: llenarlo anula
# el descubrimiento dinamico.
GEMINI_MODEL_CHAIN=
ANTHROPIC_MODEL_CHAIN=

# ===========================================================================
# FUTUROS - MATBA ROFEX / reMARKETS (nuevo en v16.2)
# ===========================================================================
# Esto es lo que destraba el pendiente de futuros. El broker de ejecucion no
# informa multiplicador de contrato ni garantia inicial, y sin esos dos
# numeros el dimensionamiento no tiene solucion. El multiplicador sale de la
# API Primary de Matba Rofex; la garantia, del reporte de cuenta.
#
# reMarkets da credenciales GRATIS con precios reales y capital virtual,
# pensado especificamente para probar esto sin riesgo:
#   https://remarkets.primary.ventures
ROFEX_ENABLED=false
ROFEX_ENVIRONMENT=REMARKETS
ROFEX_USER=
ROFEX_PASSWORD=
ROFEX_ACCOUNT=
ROFEX_CACHE_SECONDS=3600

# Garantia por contrato cargada a mano, si el reporte de cuenta no la informa.
# Formato: FUTURO_GARANTIA_<RAIZ DEL PRODUCTO>. Los aforos vigentes los
# publica Argentina Clearing.
# FUTURO_GARANTIA_DLR=

# ===========================================================================
# POLITICA DE NOTICIAS (nuevo en v16.2)
# ===========================================================================
# Que hacer cuando los feeds de noticias no responden pero las series macro
# estan frescas y el mercado opera normal.
#
#   operar_normal (default) - se opera con criterio normal. Que NUESTROS
#     servidores de RSS no contesten es una falla de infraestructura propia,
#     no un evento de mercado: el mercado esta abierto, los precios llegan y
#     el analisis tecnico funciona. Castigar el tamano de la posicion por un
#     problema de este lado del cable es atribuirle al mercado algo que no
#     paso en el mercado.
#
#   degradar - comportamiento anterior: mitad de tamano y piso de
#     rentabilidad 1,5 veces mas exigente. En la practica eso descarta casi
#     todo: una oportunidad tiene que rendir 50% mas de lo normal para pasar,
#     y si pasa se opera con la mitad. Es una parada encubierta.
#
# Las tres protecciones que miden IMPACTO REAL siguen activas con cualquiera
# de las dos politicas: corte a los 90 minutos de apagon, bloqueo si las
# series macro tambien estan viejas, y bloqueo por evento de calendario.
NEWS_FEEDS_DOWN_POLICY=operar_normal

# Eventos macro programados, separados por comas, en formato ISO. El precio
# de los minutos previos a un dato conocido no contiene la informacion que
# esta por salir.
CALENDAR_EVENTS_ENABLED=true
CALENDAR_EVENTS=
CALENDAR_EVENT_WINDOW_MINUTES=60

# ===========================================================================
# TARIFARIO POR CLASE DE ACTIVO (nuevo en v16.2)
# ===========================================================================
# La grilla vive en au_fee_schedule.py con los valores del tarifario vigente
# de PPI. Se puede pisar cualquier numero sin tocar codigo, con la forma
# FEE_<CLASE>_<CAMPO>. Existe porque los aranceles se negocian: un cliente con
# volumen puede tener una grilla distinta, y eso no deberia obligar a un
# deploy.
#   FEE_OPCIONES_COMISION=0.008
#   FEE_BONOS_DERECHO=0.0001
#
# Tolerancia del contraste contra el presupuesto que informa el broker antes
# de operar. Un desvio mayor no bloquea: avisa.
FEE_RECONCILE_TOLERANCE_PCT=5.0

# Capital minimo por debajo del cual no se abre nada (codigo
# CAPITAL_INSUFICIENTE del porton, nivel 1).
MIN_CAPITAL_ARS=0

# Intentos de codigo invalido de Telegram antes de avisar al chat autorizado.
TELEGRAM_MAX_INTENTOS_CODIGO=3
